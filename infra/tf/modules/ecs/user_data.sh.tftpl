#!/bin/bash
set -euxo pipefail

# ─── SWAP ────────────────────────────────────────────────────────
# t3.micro chỉ có 1GB RAM. ECS agent (~100MB) + nginx (~15MB) + .NET API
# (~250MB) là chật. 2GB swap giữ cho instance không bị OOM-kill khi task
# migrator chạy chồng lên hai container kia.
# Phải làm TRƯỚC khi ECS agent khởi động để container dùng được swap.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
  sysctl -w vm.swappiness=60
fi

# ─── ĐĂNG KÝ VÀO ECS CLUSTER ─────────────────────────────────────
# Đây là toàn bộ việc user_data phải làm. Mọi thứ khác (nginx, WASM bundle,
# .NET runtime, secret) đã nằm trong image hoặc do ECS agent inject — nên
# instance có thể bị xoá và dựng lại bất cứ lúc nào mà không mất gì.
{
  echo "ECS_CLUSTER=${cluster_name}"
  echo "ECS_ENABLE_CONTAINER_METADATA=true"
  echo "ECS_ENABLE_SPOT_INSTANCE_DRAINING=false"
  # 90s, không phải 30s: đây là TRẦN CHỜ mức AGENT, áp cho mọi container KHÔNG tự
  # khai stopTimeout. Nó là trần thứ hai — task definition khai 90 mà agent còn 30
  # thì agent thắng, và ta mất đúng thứ vừa sửa ở taskdef.tf mà không có lỗi nào
  # báo ra. Ràng buộc: deregistration_delay + ShutdownTimeout < giá trị này.
  echo "ECS_CONTAINER_STOP_TIMEOUT=90s"
} >> /etc/ecs/ecs.config

# ─── KHÔNG KHỞI ĐỘNG ECS AGENT Ở ĐÂY ─────────────────────────────
# Ghi ECS_CLUSTER ở trên là TOÀN BỘ việc cần làm. Trên AMI ECS-optimized, unit
# `ecs` đã được enable sẵn và tự lên sau khi cloud-init xong.
#
# Tuyệt đối KHÔNG thêm `systemctl enable --now ecs` (hay `systemctl start ecs`)
# vào đây. `ecs.service` có `After=docker.service cloud-final.service`, mà
# user_data chạy TRONG `cloud-final`. Gọi `systemctl start` từ trong cloud-init
# tạo deadlock: `systemctl` chờ unit active, unit chờ cloud-final xong,
# cloud-final chờ user_data trả về. Sự cố thật đã gặp hai lần:
#   cloud-init status  → running (đứng ở modules-final)
#   systemctl is-active ecs → inactive (dead)
#   ps → `systemctl enable --now ecs` treo, là con của `cloud-init modules --mode=final`
# Instance chạy nhưng không bao giờ đăng ký vào cluster. Gỡ bằng cách kill tiến
# trình systemctl đang treo — agent lên ngay và đăng ký được.
#
# Muốn kiểm tra agent có lên không thì xem từ ngoài, không phải từ user_data:
#   aws ecs list-container-instances --cluster ${cluster_name}
