# Existing authoritative zone ID; this is an illustrative placeholder.
zone_id = "0123456789abcdef0123456789abcdef"

web_domain = "hushstore.io.vn"
api_domain = "api.hushstore.io.vn"

# Optional source CIDRs; IPv4 and IPv6 are supported, /0 is rejected.
blocked_ip_cidrs          = []
login_requests_per_period = 20

# Required: export TF_VAR_cloudflare_origin_secret from your secret manager.
# Use the SAME generated 32–128-character value in the AWS root.
# Provider authentication: export CLOUDFLARE_API_TOKEN from your secret manager.
# Never commit either secret or a saved Terraform plan.
