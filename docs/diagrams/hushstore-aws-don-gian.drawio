        <mxCell id="necs" value="&lt;b&gt;ECS Cluster hushstore&lt;/b&gt; — capacity provider = Auto Scaling Group&lt;br&gt;• &lt;b&gt;ECS Service&lt;/b&gt; hushstore-web → task definition &lt;i&gt;web&lt;/i&gt; · nginx :80&lt;br&gt;• &lt;b&gt;ECS Service&lt;/b&gt; hushstore-api → task definition &lt;i&gt;api&lt;/i&gt; · .NET 10 :8080&lt;br&gt;• task definition &lt;i&gt;migrator&lt;/i&gt; + &lt;i&gt;seeder&lt;/i&gt;: chạy bằng run-task, KHÔNG có Service&lt;br&gt;network_mode = bridge + host port TĨNH → target group gắn qua Service, target_type = instance" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6EC;strokeColor=#248814;fontColor=#1B6310;fontSize=11;dashed=0;fontStyle=0;verticalAlign=middle;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
