          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="websg" value="④ SG web — app subnet private&lt;br&gt;IN: TCP 80/8080 chỉ từ SG ALB; không có SSH.&lt;br&gt;SG gắn EC2 host (ECS bridge, static host ports)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontColor=#232F3E;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="486" width="730" height="108" as="geometry" />
        </mxCell>
        <mxCell id="flow3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#248814;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="listener" target="websg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="app" value="⑤ Container API / web&lt;br&gt;Xác thực, phân quyền, validation dữ liệu tại ứng dụng.&lt;br&gt;SG cho phép kết nối không thay thế quyền của người dùng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#C6CDD4;fontColor=#232F3E;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="618" width="730" height="108" as="geometry" />
        </mxCell>
        <mxCell id="flow4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#248814;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="websg" target="app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="webout" value="⑥ SG web — egress&lt;br&gt;TCP 5432 chỉ tới SG RDS.&lt;br&gt;TCP 80/443 tới 0.0.0.0/0 vẫn được giữ (qua NAT khi bật)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontColor=#232F3E;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="730" height="108" as="geometry" />
        </mxCell>
        <mxCell id="flow5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#248814;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="app" target="webout">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rdssg" value="⑦ SG RDS — DB subnet private&lt;br&gt;IN: TCP 5432 chỉ từ SG web. OUT: rỗng.&lt;br&gt;RDS không public; DB không có default route ra Internet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontColor=#232F3E;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="882" width="730" height="108" as="geometry" />
        </mxCell>
        <mxCell id="flow6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#248814;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="webout" target="rdssg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="acl" value="Default network ACL — 6 subnet&lt;br&gt;&lt;br&gt;AWS tạo và quản lý; allow-all hai chiều.&lt;br&gt;Terraform không adopt, không khai rule ACL.&lt;br&gt;Không có custom ACL hay bước chặn IP trong luồng này." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EDFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="90" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="defaultsg" value="Default security group&lt;br&gt;Ingress rỗng + egress rỗng.&lt;br&gt;Không dùng làm SG cho workload." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C6CDD4;fontColor=#232F3E;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="290" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="response" value="Đường phản hồi — tự động bởi stateful SG&lt;br&gt;&lt;br&gt;RDS → API → ALB → người dùng.&lt;br&gt;Phản hồi của kết nối được SG cho phép không cần rule ephemeral hoặc rule egress mới trên RDS.&lt;br&gt;Default ACL allow-all cho cả đường đi và đường về." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontColor=#232F3E;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="425" width="480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="endpointweb" value="SG web (egress 443 đang có)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontColor=#232F3E;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="660" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="endpoint" value="ECR interface endpoints — TUỲ CHỌN&lt;br&gt;SG endpoint IN: TCP 443 chỉ từ SG web.&lt;br&gt;OUT: rỗng; phản hồi stateful.&lt;br&gt;Mặc định tắt; không bật chỉ để đổi mạng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EDFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=13;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="775" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="endpoint443" value="TCP 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8C4FFF;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="endpointweb" target="endpoint">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="migration" value="Revision thiết kế; chưa đo lại AWS.&lt;br&gt;State cũ: chuyển association về default ACL trước, rồi mới xoá custom ACL.&lt;br&gt;Chi tiết: docs/nacl-to-sg-migration.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D86613;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="940" width="480" height="115" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p-3" name="3 — Kiểm chứng SG sau migration">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Kiểm chứng sau migration — kết quả mong đợi, chưa đo lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C6CDD4;fontColor=#232F3E;fontSize=21;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="check0" value="WAF + origin lockdown&lt;br&gt;&lt;br&gt;Edge → ALB: 80/443 từ IP Cloudflare.&lt;br&gt;Host AND secret; gọi trực tiếp phải bị chặn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontColor=#232F3E;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="640" height="195" as="geometry" />
        </mxCell>
        <mxCell id="check1" value="ALB → web&lt;br&gt;&lt;br&gt;SG ALB egress TCP 80/8080 → SG web.&lt;br&gt;SG web ingress TCP 80/8080 ← SG ALB; không dùng CIDR subnet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontColor=#232F3E;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="640" height="195" as="geometry" />
        </mxCell>
        <mxCell id="check2" value="web → RDS&lt;br&gt;&lt;br&gt;SG web egress TCP 5432 → SG RDS.&lt;br&gt;SG RDS ingress TCP 5432 ← SG web; egress rỗng, phản hồi stateful." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontColor=#232F3E;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="365" width="640" height="195" as="geometry" />
        </mxCell>
        <mxCell id="check3" value="Egress từ web&lt;br&gt;&lt;br&gt;Giữ TCP 80/443 → 0.0.0.0/0 cho bootstrap và AWS APIs.&lt;br&gt;NAT / route cần sẵn khi workload dùng public endpoints." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontColor=#232F3E;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="365" width="640" height="195" as="geometry" />
        </mxCell>
        <mxCell id="check4" value="ECR endpoint tuỳ chọn&lt;br&gt;&lt;br&gt;Nếu bật: SG endpoint chỉ nhận TCP 443 từ SG web.&lt;br&gt;Không mở 443 theo CIDR VPC; không bật endpoint chỉ để migration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontColor=#232F3E;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="640" height="195" as="geometry" />
        </mxCell>
        <mxCell id="check5" value="Default resources&lt;br&gt;&lt;br&gt;6 subnet gắn default ACL allow-all hai chiều, AWS quản lý.&lt;br&gt;0 custom ACL; default SG ingress/egress rỗng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;fontColor=#232F3E;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="610" width="640" height="195" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="Đây là checklist để đo sau apply; không phải kết quả pass mới.&lt;br&gt;Bằng chứng cũ giữ nguyên tại docs/security-validation-report.md và docs/evidence/.&lt;br&gt;Migration từ state cũ: docs/nacl-to-sg-migration.md — kiểm association trước khi xoá custom ACL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D86613;fontColor=#232F3E;fontSize=15;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="1320" height="115" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>