<mxfile host="app.diagrams.net" agent="hushstore-gen" version="24.0.0" type="device"><diagram name="1 — Kiến trúc tổng thể" id="p-1"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Hạ tầng AWS của HushStore — kiến trúc tổng thể" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1000" height="28" as="geometry"/></mxCell><mxCell id="n2" value="Đề tài 513 · dựng bằng Terraform · VPC, Security Group, Network ACL, Application Load Balancer, EC2 Instance" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A5A5A;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1150" height="20" as="geometry"/></mxCell><mxCell id="n3" value="Người dùng Internet" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="112" y="88" width="70" height="70" as="geometry"/></mxCell><mxCell id="n4" value="Cloudflare DNS&lt;br&gt;hushstore.io.vn → CNAME của ALB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="215" y="92" width="205" height="58" as="geometry"/></mxCell><mxCell id="n5" value="Máy tấn công&lt;br&gt;(laptop — var.my_ip)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="1178" y="88" width="62" height="70" as="geometry"/></mxCell><mxCell id="n6" value="AWS Cloud — account 551897327153" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="192" width="1330" height="712" as="geometry"/></mxCell><mxCell id="n7" value="Region ap-southeast-1 (Singapore)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#147EBA;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="1"><mxGeometry x="62" y="228" width="1286" height="656" as="geometry"/></mxCell><mxCell id="n8" value="VPC hushstore-vpc — 10.20.0.0/16" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="1"><mxGeometry x="84" y="268" width="990" height="600" as="geometry"/></mxCell><mxCell id="n9" value="Internet Gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_gateway;verticalLabelPosition=middle;verticalAlign=middle;labelPosition=right;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="238" width="60" height="60" as="geometry"/></mxCell><mxCell id="n10" value="Public subnet × 2 AZ — 10.20.0.0/24 (ap-southeast-1a) · 10.20.1.0/24 (1b)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#248814;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontColor=#248814;fontSize=12;" vertex="1" parent="1"><mxGeometry x="104" y="352" width="950" height="150" as="geometry"/></mxCell><mxCell id="n11" value="NAT Gateway&lt;br&gt;(chỉ bật khi cần)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.nat_gateway;" vertex="1" parent="1"><mxGeometry x="160" y="406" width="62" height="62" as="geometry"/></mxCell><mxCell id="n12" value="sg-alb — ingress 80, 443 ← 0.0.0.0/0 · egress CHỈ tới sg-web" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DD3522;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontColor=#DD3522;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="392" width="330" height="100" as="geometry"/></mxCell><mxCell id="n13" value="Application Load Balancer&lt;br&gt;listener 80 → 443 (ACM)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;verticalLabelPosition=middle;verticalAlign=middle;labelPosition=right;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="280" y="406" width="62" height="62" as="geometry"/></mxCell><mxCell id="n14" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.network_access_control_list;" vertex="1" parent="1"><mxGeometry x="700" y="412" width="46" height="46" as="geometry"/></mxCell><mxCell id="n15" value="nacl-public&lt;br&gt;• 100/110 IN: allow 80, 443 ← 0.0.0.0/0&lt;br&gt;• 120 IN: allow 1024-65535 (traffic quay về)&lt;br&gt;• 50 IN: DENY toàn bộ từ var.my_ip" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="756" y="384" width="290" height="100" as="geometry"/></mxCell><mxCell id="n16" value="App subnet × 2 AZ — 10.20.10.0/24 · 10.20.11.0/24 — KHÔNG có public IP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#147EBA;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontColor=#147EBA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="104" y="532" width="950" height="170" as="geometry"/></mxCell><mxCell id="n17" value="sg-web — ingress 80, 8080 CHỈ ← sg-alb · không có rule port 22 nào" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DD3522;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontColor=#DD3522;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="560" width="440" height="130" as="geometry"/></mxCell><mxCell id="n18" value="EC2 t3.micro — ECS container instance&lt;br&gt;container web nginx :80 · container api .NET :8080&lt;br&gt;task migrator: chạy xong thì thoát" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;verticalLabelPosition=middle;verticalAlign=middle;labelPosition=right;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="283" y="606" width="56" height="56" as="geometry"/></mxCell><mxCell id="n19" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.network_access_control_list;" vertex="1" parent="1"><mxGeometry x="700" y="606" width="46" height="46" as="geometry"/></mxCell><mxCell id="n20" value="nacl-app&lt;br&gt;• 90 DENY 22 · 95 DENY 1433 · 115 DENY 8080&lt;br&gt;• 100/110 IN: allow 80, 8080 ← chỉ CIDR public&lt;br&gt;• 120 IN: allow 1024-65535 ← 0.0.0.0/0&lt;br&gt;  (buộc phải mở → nên mới cần 90/95/115)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="756" y="560" width="290" height="130" as="geometry"/></mxCell><mxCell id="n21" value="DB subnet × 2 AZ — 10.20.20.0/24 · 10.20.21.0/24 — route table KHÔNG có đường ra Internet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#147EBA;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontColor=#147EBA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="104" y="732" width="950" height="122" as="geometry"/></mxCell><mxCell id="n22" value="sg-rds — ingress 1433 CHỈ ← sg-web · egress rỗng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DD3522;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontColor=#DD3522;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="766" width="290" height="78" as="geometry"/></mxCell><mxCell id="n23" value="RDS SQL Server Express&lt;br&gt;publicly_accessible = false" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.rds_sql_server_instance;verticalLabelPosition=middle;verticalAlign=middle;labelPosition=right;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="283" y="770" width="56" height="56" as="geometry"/></mxCell><mxCell id="n24" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.network_access_control_list;" vertex="1" parent="1"><mxGeometry x="700" y="772" width="46" height="46" as="geometry"/></mxCell><mxCell id="n25" value="nacl-db&lt;br&gt;• 100 IN: allow 1433 ← chỉ CIDR app&lt;br&gt;• *  : deny — không có rule nào khác" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="756" y="756" width="290" height="70" as="geometry"/></mxCell><mxCell id="n26" value="Dịch vụ AWS quản lý (ngoài VPC)&lt;br&gt;&lt;br&gt;EC2 gọi ra các dịch vụ này qua NAT Gateway:" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9A9A9A;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1092" y="352" width="240" height="502" as="geometry"/></mxCell><mxCell id="n27" value="ECR — 3 repo image" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1"><mxGeometry x="1122" y="432" width="52" height="52" as="geometry"/></mxCell><mxCell id="n28" value="SSM Parameter Store" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="1"><mxGeometry x="1122" y="552" width="52" height="52" as="geometry"/></mxCell><mxCell id="n29" value="CloudWatch Logs" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="1122" y="664" width="52" height="52" as="geometry"/></mxCell><mxCell id="n30" value="ACM — chứng chỉ TLS" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager_3;" vertex="1" parent="1"><mxGeometry x="1122" y="776" width="52" height="52" as="geometry"/></mxCell><mxCell id="e31" value="① tra DNS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="② HTTPS 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="n3" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="147" y="182"/><mxPoint x="555" y="182"/></Array></mxGeometry></mxCell><mxCell id="e33" value="nmap · :1433 · :22 — bị chặn (xem trang 3)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#DD344C;fontColor=#DD344C;strokeWidth=2;exitX=0;exitY=0.5;entryX=0.75;entryY=0;" edge="1" parent="1" source="n5" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="123"/></Array></mxGeometry></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n9" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e35" value="80 / 8080" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n13" target="n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36" value="1433" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n18" target="n23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e37" value="egress" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#666666;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n18" target="n11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="634"/><mxPoint x="125" y="437"/></Array></mxGeometry></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#666666;exitX=0.5;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="n11" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="191" y="330"/><mxPoint x="555" y="330"/></Array></mxGeometry></mxCell><mxCell id="n39" value="Nguyên tắc tối thiểu — ba điều đọc được ngay trên sơ đồ:  (1) mỗi Security Group chỉ nhận traffic từ SG đứng ngay trước nó, không khai báo theo dải IP, nên thêm một máy vào hệ thống không tự động mở thêm đường nào;  (2) Network ACL lọc thêm một lần ở mức subnet và chặn được đúng một địa chỉ IP — điều Security Group không làm được, vì SG chỉ có luật cho phép;  (3) port 22 không mở ở bất kỳ đâu — vào máy bằng SSM Session Manager, không key pair, không file .pem." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="918" width="1330" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 — Luồng request đi từ ngoài vào trong" id="p-2"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Một request hợp lệ đi qua những chốt kiểm nào" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1000" height="28" as="geometry"/></mxCell><mxCell id="n2" value="Đọc theo số ① → ⑩. Mỗi chốt là một lần hệ thống hỏi lại: gói tin này có được phép đi tiếp không?" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A5A5A;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1100" height="20" as="geometry"/></mxCell><mxCell id="n3" value="① Client&lt;br&gt;Trình duyệt gửi HTTPS tới hushstore.io.vn. Cloudflare trả về tên DNS của ALB." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="400" height="96" as="geometry"/></mxCell><mxCell id="n4" value="② nacl-public — vào subnet public&lt;br&gt;Rule 100/110 allow 80, 443 ← 0.0.0.0/0. Rule 50 DENY riêng var.my_ip: chặn được đúng một IP." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="262" width="400" height="96" as="geometry"/></mxCell><mxCell id="n5" value="③ sg-alb&lt;br&gt;Ingress 80, 443 ← 0.0.0.0/0. Egress CHỈ tới sg-web:80 và :8080 — ALB không nói chuyện được với gì khác." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="374" width="400" height="96" as="geometry"/></mxCell><mxCell id="n6" value="④ Application Load Balancer&lt;br&gt;Giải mã TLS bằng chứng chỉ ACM. Host = api.hushstore.io.vn → tg-api :8080, còn lại → tg-web :80. Host lạ → 403." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="486" width="400" height="96" as="geometry"/></mxCell><mxCell id="n7" value="⑤ nacl-app — vào subnet app&lt;br&gt;90 DENY 22 · 95 DENY 1433 · 115 DENY 8080 ← 0.0.0.0/0, đặt TRƯỚC rule 120. 100/110 allow 80, 8080 ← chỉ CIDR public." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="598" width="400" height="96" as="geometry"/></mxCell><mxCell id="n8" value="⑥ sg-web&lt;br&gt;Ingress 80, 8080 CHỈ ← sg-alb — lọc theo danh tính Security Group, không theo địa chỉ IP. Không có rule port 22 nào." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="150" width="400" height="96" as="geometry"/></mxCell><mxCell id="n9" value="⑦ EC2 + container&lt;br&gt;EC2 t3.micro trong app subnet, không có public IP. Container nginx :80 và container api .NET :8080." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="262" width="400" height="96" as="geometry"/></mxCell><mxCell id="n10" value="⑧ nacl-db — vào subnet db&lt;br&gt;Rule 100 allow 1433 ← chỉ CIDR app. Ngoài rule đó không có gì → * deny." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="374" width="400" height="96" as="geometry"/></mxCell><mxCell id="n11" value="⑨ sg-rds&lt;br&gt;Ingress 1433 CHỈ ← sg-web. Egress để RỖNG — SG có state nên vẫn trả lời được." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="486" width="400" height="96" as="geometry"/></mxCell><mxCell id="n12" value="⑩ RDS SQL Server&lt;br&gt;publicly_accessible = false. Endpoint công khai phân giải ra IP riêng 10.20.21.168 (đã đo)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="598" width="400" height="96" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="tiếp tục ⑥" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="465" y="646"/><mxPoint x="465" y="198"/></Array></mxGeometry></mxCell><mxCell id="n22" value="Đường về — vì sao bảng NACL dài gấp đôi bảng SG&lt;br&gt;&lt;br&gt;Security Group có state: nó nhớ kết nối vừa cho đi, nên gói tin trả lời tự động được cho qua. Đó là lý do sg-rds để egress rỗng mà RDS vẫn trả được dữ liệu.&lt;br&gt;&lt;br&gt;Network ACL không có state. Với nó, gói tin trả lời là một gói MỚI, phải có rule riêng cho chiều về.&lt;br&gt;&lt;br&gt;Traffic quay về từ Internet mang cổng đích ngẫu nhiên trong dải 1024-65535, nên nacl-app buộc phải allow cả dải này từ 0.0.0.0/0 — đó là rule 120." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="150" width="350" height="300" as="geometry"/></mxCell><mxCell id="n23" value="Kết luận đáng nhớ nhất&lt;br&gt;&lt;br&gt;1433 và 8080 nằm TRONG dải 1024-65535 mà rule 120 vừa mở. Ba rule DENY 22 / 1433 / 8080 đặt ở số nhỏ hơn (90 / 95 / 115) tồn tại chính là để vá cái lỗ rule 120 mở ra.&lt;br&gt;&lt;br&gt;Đây là câu trả lời cho “đã có Network ACL rồi thì cần Security Group làm gì”." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9A9A9A;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="462" width="350" height="148" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 — Các luật đã chặn tấn công ở đâu" id="p-3"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Máy tấn công thử gì, bị chặn ở lớp nào, kết quả đo được" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1100" height="28" as="geometry"/></mxCell><mxCell id="n2" value="Sáu kịch bản tiêu biểu, chạy từ laptop (var.my_ip) trên hạ tầng thật của account 551897327153" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A5A5A;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1200" height="20" as="geometry"/></mxCell><mxCell id="n3" value="Kịch bản tấn công" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="280" height="44" as="geometry"/></mxCell><mxCell id="n4" value="Bị chặn ở lớp nào" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="210" height="44" as="geometry"/></mxCell><mxCell id="n5" value="Luật chịu trách nhiệm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="350" height="44" as="geometry"/></mxCell><mxCell id="n6" value="Kết quả đo được" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="890" y="140" width="340" height="44" as="geometry"/></mxCell><mxCell id="n7" value="nmap -Pn -p- tên-DNS-của-ALB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="184" width="280" height="74" as="geometry"/></mxCell><mxCell id="n8" value="sg-alb" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="184" width="210" height="74" as="geometry"/></mxCell><mxCell id="n9" value="ingress chỉ có 80 và 443" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="540" y="184" width="350" height="74" as="geometry"/></mxCell><mxCell id="n10" value="80 + 443 open, 998 port còn lại filtered" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="890" y="184" width="340" height="74" as="geometry"/></mxCell><mxCell id="n11" value="sqlcmd tới endpoint RDS :1433" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="258" width="280" height="74" as="geometry"/></mxCell><mxCell id="n12" value="3 lớp cùng lúc: RDS + nacl-db + sg-rds" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="258" width="210" height="74" as="geometry"/></mxCell><mxCell id="n13" value="publicly_accessible = false · nacl-db * deny · sg-rds ← chỉ sg-web" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="540" y="258" width="350" height="74" as="geometry"/></mxCell><mxCell id="n14" value="endpoint phân giải ra IP riêng 10.20.21.168; socket timeout — bị drop im lặng, không phải refused" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="890" y="258" width="340" height="74" as="geometry"/></mxCell><mxCell id="n15" value="ssh port 22 vào ALB và vào EC2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="332" width="280" height="74" as="geometry"/></mxCell><mxCell id="n16" value="sg-web + nacl-app" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="332" width="210" height="74" as="geometry"/></mxCell><mxCell id="n17" value="không SG nào có rule phủ port 22 · nacl-app rule 90 DENY 22" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="540" y="332" width="350" height="74" as="geometry"/></mxCell><mxCell id="n18" value="Operation timed out cả hai hướng; 0 key pair trong toàn region; launch template KeyName = None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="890" y="332" width="340" height="74" as="geometry"/></mxCell><mxCell id="n19" value="curl http://tên-DNS-ALB:8080" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="406" width="280" height="74" as="geometry"/></mxCell><mxCell id="n20" value="ALB listener" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="406" width="210" height="74" as="geometry"/></mxCell><mxCell id="n21" value="ALB chỉ tạo listener 80 và 443" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="540" y="406" width="350" height="74" as="geometry"/></mxCell><mxCell id="n22" value="timeout (curl exit 28) — không phải refused, tức không có gì đang nghe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="890" y="406" width="340" height="74" as="geometry"/></mxCell><mxCell id="n23" value="curl -H &quot;Host: evil.com&quot; tới ALB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="480" width="280" height="74" as="geometry"/></mxCell><mxCell id="n24" value="ALB listener rule" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="480" width="210" height="74" as="geometry"/></mxCell><mxCell id="n25" value="allowlist theo Host + default action fixed-response" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="540" y="480" width="350" height="74" as="geometry"/></mxCell><mxCell id="n26" value="403 cho evil.com, cho www và cho cả tên DNS thô của ALB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="890" y="480" width="340" height="74" as="geometry"/></mxCell><mxCell id="n27" value="Bật enable_deny_demo rồi curl từ laptop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="554" width="280" height="74" as="geometry"/></mxCell><mxCell id="n28" value="nacl-public" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="554" width="210" height="74" as="geometry"/></mxCell><mxCell id="n29" value="rule 50 DENY toàn bộ từ var.my_ip" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="540" y="554" width="350" height="74" as="geometry"/></mxCell><mxCell id="n30" value="A/B trên CÙNG một máy: đường trực tiếp timeout, đường qua Cloudflare vẫn 200 ⇒ NACL chặn được 1 IP, SG thì không" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#9A9A9A;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="890" y="554" width="340" height="74" as="geometry"/></mxCell><mxCell id="n31" value="Còn sáu kịch bản nữa, tất cả đều đạt (12/12): brute-force /api/auth/login trả 429 từ request thứ 6 · VPC Flow Logs ghi 2264 bản ghi REJECT trong 30 phút, khớp đúng đợt nmap của nhóm · ma trận 18 phép thử cho thấy mỗi IAM role chỉ thấy phần việc của nó, host bị explicit Deny trên cả bốn action đọc parameter · 3/3 lần giả mạo OIDC assume-role đều thất bại. Chi tiết và log gốc: docs/security-validation-report.md" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9A9A9A;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="642" width="1180" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>