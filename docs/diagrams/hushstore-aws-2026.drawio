        <mxCell id="bridgen" value="network_mode = bridge, host port TĨNH 80 và 8080 → sg-web chỉ cần 2 rule, không phải mở dải 32768-65535." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=9;fontColor=#3B4A57;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="512" y="782" width="244" height="56" as="geometry" />
        </mxCell>
        <mxCell id="apbn" value="ASG khai báo CẢ hai app subnet. AZ-a hết capacity thì instance mới lên ở đây, không phải sửa gì. Bình thường AZ này rỗng." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#5A6C7D;fontColor=#232F3E;fontSize=10;dashed=0;fontStyle=0;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
