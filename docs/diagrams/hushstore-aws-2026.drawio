          <mxGeometry x="1218" y="1060" width="52" height="52" as="geometry" />
        </mxCell>
        <mxCell id="rtn" value="Route table&lt;br&gt;• rt-public → 0.0.0.0/0 qua IGW&lt;br&gt;• rt-private → 0.0.0.0/0 qua NAT (chỉ khi enable_nat)&lt;br&gt;• rt-db → KHÔNG có route 0.0.0.0/0, không bao giờ có" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=9;dashed=0;fontStyle=0;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
