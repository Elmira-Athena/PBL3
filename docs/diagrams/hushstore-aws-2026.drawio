        </mxCell>
        <mxCell id="alb" value="Application Load Balancer&lt;br&gt;TLS 1.2/1.3 · 2 target group" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;" vertex="1" parent="1">
          <mxGeometry x="756" y="435" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pbn" value="nat_gateway_count = 2 (ghim trong envs/prod/variables.tf): MỖI AZ một NAT Gateway + EIP riêng, và private route table của mỗi AZ trỏ vào NAT của CHÍNH AZ đó. Mất AZ-a thì app subnet ở đây vẫn có egress. Giá: +$0,059/giờ." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#5A6C7D;fontColor=#232F3E;fontSize=10;dashed=0;fontStyle=0;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="915" y="420" width="258" height="92" as="geometry" />
        </mxCell>
