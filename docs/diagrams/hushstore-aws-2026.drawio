        <mxCell id="rdsn" value="publicly_accessible = false  ·  chỉ nghe :5432  ·  SSL Mode=VerifyFull + Root Certificate (bundle CA của AWS)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=9;fontColor=#3B4A57;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="405" y="1038" width="350" height="44" as="geometry" />
        </mxCell>
        <mxCell id="dbbn" value="enable_multi_az = true (ghim trong envs/prod/variables.tf) → standby ĐỒNG BỘ của RDS nằm ở AZ này, tự failover. Standby KHÔNG phục vụ đọc — đây là tính sẵn sàng, không phải read scaling.&lt;br&gt;&lt;br&gt;Cái giá: storage tính tiền ở CẢ HAI AZ, kể cả khi instance đã stopped." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#5A6C7D;fontColor=#232F3E;fontSize=10;dashed=0;fontStyle=0;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
