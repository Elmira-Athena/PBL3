        <mxCell id="naclhn" value="stateless — phải&lt;br&gt;khai CẢ hai chiều" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=9;fontColor=#3B4A57;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1266" y="352" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="nacl_pub" value="nacl-public&lt;br&gt;IN  100 allow 80&lt;br&gt;IN  110 allow 443&lt;br&gt;IN  120 allow 1024-65535&lt;br&gt;IN  50  DENY var.my_ip&lt;br&gt;OUT 100/110 → app 80/8080&lt;br&gt;OUT 120/125 → 0.0.0.0/0 80/443&lt;br&gt;OUT 130 → 1024-65535" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=9;dashed=0;fontStyle=0;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1218" y="400" width="160" height="138" as="geometry" />
        </mxCell>
        <mxCell id="nacl_app" value="nacl-app&lt;br&gt;IN  90  DENY 22&lt;br&gt;IN  95  DENY 5432&lt;br&gt;IN  100 allow 80 ← public&lt;br&gt;IN  110 allow 8080 ← public&lt;br&gt;IN  115 DENY 8080 ← mọi nơi&lt;br&gt;IN  120 allow 1024-65535&lt;br&gt;OUT 100 → db 5432&lt;br&gt;OUT 110/115 → 80/443&lt;br&gt;OUT 120 → public 1024-65535&lt;br&gt;&lt;br&gt;rule 90/95/115 tồn tại VÌ&lt;br&gt;rule 120 buộc phải mở&lt;br&gt;dải ephemeral" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=9;dashed=0;fontStyle=0;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1218" y="585" width="160" height="250" as="geometry" />
        </mxCell>
        <mxCell id="nacl_db" value="nacl-db&lt;br&gt;IN  100 allow 5432 ← app&lt;br&gt;OUT 100 → app 1024-65535&lt;br&gt;&lt;br&gt;Hết. Không rule nào khác.&lt;br&gt;Mọi thứ còn lại: deny." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=9;dashed=0;fontStyle=0;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
