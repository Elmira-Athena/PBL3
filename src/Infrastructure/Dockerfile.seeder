# syntax=docker/dockerfile:1.7
# Parser directive BẮT BUỘC phải là dòng đầu tiên của file. Nó ghim frontend
# Dockerfile ở 1.7 để cờ `ADD --checksum` bên dưới chắc chắn được hỗ trợ: cờ đó
# xuất hiện từ frontend 1.6, và nếu build bằng frontend cũ hơn thì lỗi báo ra là
# "unknown flag" — nghe như lỗi cú pháp chứ không như lỗi phiên bản.
# Build context là REPO ROOT.
#   docker build -f src/Infrastructure/Dockerfile.seeder -t hushstore-seeder:tag .
#
# ─── TẠI SAO CÓ IMAGE NÀY ────────────────────────────────────────────────────
# Kế hoạch ban đầu là seed bằng cách vào container instance qua SSM rồi chạy một
# image client sẵn có, đọc mật khẩu DB bằng `aws ssm get-parameter` NGAY TRÊN HOST.
# Lý do phải bỏ cách đó: role của container instance bị DENY tường minh
# ssm:GetParameter* trên arn:aws:ssm:*:*:parameter/hushstore/* — đó là một
# deliverable của đồ án (host bị chiếm thì không đọc được secret nào), đã kiểm
# chứng bằng IAM simulator và trên instance thật. Không nới ra.
#
# Nên: seed bằng một one-off ECS task. Mật khẩu đi theo đường `secrets` của ECS
# (execution role đọc SSM), KHÔNG BAO GIỜ chạm host và không nằm trong shell
# history. Đây đúng là con đường mà task migrator đã chạy thành công.
#
# ─── ĐỢT 7: sqlcmd → psql ────────────────────────────────────────────────────
# Bản trước cài msodbcsql18 + mssql-tools18 từ packages.microsoft.com. Cả khối đó
# biến mất cùng SQL Server. Ghi lại phần lý lẽ CÒN GIÁ TRỊ để phiên sau không phải
# dò lại: mssql-tools18 KHÔNG tồn tại dạng container image (registry trả 404), chỉ
# có dạng package apt/yum — nên nếu có ngày quay lại SQL Server thì đừng đi tìm
# `docker run mcr.microsoft.com/mssql-tools18`.

FROM --platform=linux/amd64 debian:12-slim

# psql 17 từ kho PGDG, KHÔNG dùng postgresql-client của Debian 12 (đó là bản 15).
# Lý do ghim đúng major của server: client cũ hơn vẫn nối được, nhưng nó là một
# khác biệt âm thầm giữa môi trường seed và môi trường chạy — và khi có sự cố thì
# "client 15 nói chuyện với server 17" là biến số phải loại trừ trước, tốn thời
# gian đúng lúc không có thời gian. Ghim luôn cho khỏi phải nghĩ.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg; \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor -o /usr/share/keyrings/postgresql.gpg; \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends postgresql-client-17; \
    apt-get purge -y --auto-remove gnupg; \
    rm -rf /var/lib/apt/lists/*

# Amazon RDS CA cho ap-southeast-1. Bắt buộc: entrypoint chạy với
# PGSSLMODE=verify-full, nghĩa là psql XÁC THỰC cert của server, nên CA của RDS
# phải có mặt và được trỏ tới bằng PGSSLROOTCERT. Thiếu bước này thì lỗi hiện ra
# là "SSL error: certificate verify failed" chứ không phải lỗi mạng — dễ mất thời
# gian đoán sai.
#
# ⚠️ Khác bản SQL Server: psql KHÔNG đọc trust store của hệ thống. `update-ca-certificates`
# một mình là KHÔNG ĐỦ — libpq tìm CA ở ~/.postgresql/root.crt hoặc ở đường dẫn
# PGSSLROOTCERT nêu tường minh. Vẫn chạy update-ca-certificates vì `curl` trong
# image dùng trust store hệ thống, nhưng thứ làm psql tin được RDS là biến môi
# trường ở entrypoint. Xoá biến đó đi thì kết nối GÃY, không phải tụt xuống chế độ
# kém an toàn — hỏng ồn ào, đúng hướng.
#
# --checksum ghim nội dung file tải về. Không có nó, `ADD` từ URL là một điểm
# tin cậy mù: mỗi lần build lại có thể nhận nội dung khác mà build vẫn xanh, và
# thứ đang được nạp ở đây là CA — cái quyết định container tin cert nào.
# Ai kiểm soát được đường tải là ghi thêm được CA vào chỗ đó.
# SHA-256 đo ngày 2026-08-22 bằng:
#   curl -fsSL https://truststore.pki.rds.amazonaws.com/ap-southeast-1/ap-southeast-1-bundle.pem | shasum -a 256
# AWS luân phiên CA bundle theo lịch nhiều năm; khi build fail vì checksum lệch
# thì ĐỌC changelog của AWS trước rồi mới cập nhật giá trị này — đừng xoá cờ.
ADD --checksum=sha256:3c696020a3b7c6721085d182211c28024ab01873ade35dcc7eeebb89c20ee979 \
    https://truststore.pki.rds.amazonaws.com/ap-southeast-1/ap-southeast-1-bundle.pem \
    /usr/local/share/ca-certificates/rds-ap-southeast-1.crt
RUN chmod 644 /usr/local/share/ca-certificates/rds-ap-southeast-1.crt \
    && update-ca-certificates

# File seed BAKE VÀO IMAGE, không tải từ S3 lúc chạy: image không cần AWS CLI,
# không cần quyền S3, và nội dung seed được version cùng image tag.
WORKDIR /seed
COPY Infrastructure/db/seed_data.sql         ./01-seed_data.sql
COPY Infrastructure/db/seed_product_data.sql ./02-seed_product_data.sql
COPY src/Infrastructure/seed-entrypoint.sh   /usr/local/bin/seed
RUN chmod +x /usr/local/bin/seed

ENTRYPOINT ["/usr/local/bin/seed"]
