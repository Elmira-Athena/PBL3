@page "/build-pc"
@layout StorefrontLayout
@using PBL3.Shared.DTOs.BuildPc
@using Client.Services.BuildPc
@using Client.Services.Cart
@inject IBuildPcClientService BuildPcService
@inject ICartClientService CartService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Xây dựng PC - HushStore</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-10">

    @* ── Header ── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h5" Style="font-weight:700;">
            Build PC - Chọn linh kiện xây dựng cấu hình
        </MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="ResetAll">
            LÀM MỚI
        </MudButton>
    </MudStack>

    @* ── Cost estimate (top) ── *@
    <div class="d-flex justify-end mb-3">
        <MudText Typo="Typo.subtitle1">
            Chi phí dự tính:
            <strong style="color:#c0392b; font-size:1.2rem;">@TotalCost.ToString("N0")đ</strong>
        </MudText>
    </div>

    @* ── Component table ── *@
    <MudPaper Elevation="2" Class="rounded-lg overflow-hidden">

        @* Column header — chỉ hiện khi có ít nhất 1 slot đã chọn *@
        @if (HasAnyItem)
        {
            <div class="build-pc-header-row d-flex align-center">
                <div class="slot-label" style="visibility:hidden;"></div>
                <div class="slot-content build-pc-header-content">
                    <div style="flex:1; font-weight:700;">Tên sản phẩm</div>
                    <div style="width:110px; font-weight:700; text-align:center;">Số lượng</div>
                    <div style="width:130px; font-weight:700; text-align:right;">Đơn giá</div>
                    <div style="width:140px; font-weight:700; text-align:right;">Thành tiền</div>
                    <div style="width:90px;"></div>
                </div>
            </div>
            <MudDivider />
        }

        @* Tất cả 16 slot theo thứ tự cố định *@
        @foreach (var slot in _slots)
        {
            <div class="build-pc-row d-flex align-center">
                <div class="slot-label">
                    <MudText Typo="Typo.body1" Style="font-weight:600;">
                        @slot.Index. @slot.Name
                    </MudText>
                </div>
                <div class="slot-content">
                    @if (slot.SelectedItem == null)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="@(() => OpenPicker(slot))">
                            Chọn @slot.Name
                        </MudButton>
                    }
                    else
                    {
                        <div class="slot-selected-item">
                            <div class="slot-col-name d-flex align-center gap-2">
                                @if (!string.IsNullOrEmpty(slot.SelectedItem!.ImageUrl))
                                {
                                    <img src="@slot.SelectedItem!.ImageUrl"
                                         style="width:40px; height:40px; object-fit:contain; flex-shrink:0;" />
                                }
                                <div>
                                    <MudText Typo="Typo.body2" Style="font-weight:600;">@slot.SelectedItem!.ProductName</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@slot.SelectedItem!.VariantName</MudText>
                                    @if (slot.SelectedItem!.WarrantyMonth > 0)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            Bảo hành: @slot.SelectedItem!.WarrantyMonth tháng
                                        </MudText>
                                    }
                                </div>
                            </div>
                            <div class="slot-col-qty">
                                <MudNumericField T="int"
                                                Value="@slot.SelectedItem!.Quantity"
                                                ValueChanged="@(q => UpdateQuantity(slot, q))"
                                                Min="1" Max="10"
                                                Variant="Variant.Outlined"
                                                Margin="Margin.Dense"
                                                Style="width:72px;" />
                            </div>
                            <div class="slot-col-price">
                                <MudText Typo="Typo.body2" Style="white-space:nowrap;">
                                    @slot.SelectedItem!.UnitPrice.ToString("N0")đ
                                </MudText>
                            </div>
                            <div class="slot-col-total">
                                <MudText Typo="Typo.body2" Color="Color.Error"
                                         Style="font-weight:700; white-space:nowrap;">
                                    @((slot.SelectedItem!.UnitPrice * slot.SelectedItem!.Quantity).ToString("N0"))đ
                                </MudText>
                            </div>
                            <div class="slot-col-actions d-flex gap-1 justify-end">
                                <MudTooltip Text="Thay đổi linh kiện">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                                   Size="Size.Small" Color="Color.Primary"
                                                   OnClick="@(() => OpenPicker(slot))" />
                                </MudTooltip>
                                <MudTooltip Text="Xóa">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => RemoveItem(slot))" />
                                </MudTooltip>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <MudDivider />
        }

    </MudPaper>

    @* ── Cost estimate (bottom) ── *@
    <div class="d-flex justify-end mt-3 mb-5">
        <MudText Typo="Typo.subtitle1">
            Chi phí dự tính:
            <strong style="color:#c0392b; font-size:1.2rem;">@TotalCost.ToString("N0")đ</strong>
        </MudText>
    </div>

    @* ── Action buttons ── *@
    <MudStack Row="true" Spacing="2" Class="mb-10">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.SaveAlt"
                   OnClick="ExportExcel"
                   Disabled="@(_isExporting || !HasAnyItem)">
            @if (_isExporting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            LƯU CẤU HÌNH
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ShoppingCart"
                   OnClick="AddAllToCart"
                   Disabled="@(_isAddingToCart || !HasAnyItem)">
            @if (_isAddingToCart)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            THÊM VÀO GIỎ HÀNG
        </MudButton>
    </MudStack>

    @* ── Reference configs ── *@
    <MudDivider Class="mb-6" />
    <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight:700; text-align:center;">
        CẤU HÌNH PC THAM KHẢO
    </MudText>
    <MudGrid Spacing="3">
        @foreach (var preset in _presets)
        {
            <MudItem xs="12" sm="12" md="6">
                <MudCard Elevation="2" Class="rounded-lg">
                    <MudCardContent Class="pb-2">
                        <MudText Typo="Typo.subtitle1" Color="Color.Primary"
                                 Style="font-weight:700; text-transform:uppercase; letter-spacing:.05em; margin-bottom:12px;">
                            @preset.Title
                        </MudText>

                        @* Bảng linh kiện *@
                        <MudTable Items="@preset.Items" Hover="true" Elevation="0"
                                  Dense="true" Class="border rounded preset-table">
                            <HeaderContent>
                                <MudTh Style="font-weight:700; width:140px;">Linh kiện</MudTh>
                                <MudTh Style="font-weight:700;">Sản phẩm</MudTh>
                                <MudTh Style="font-weight:700; width:70px; text-align:center;">Số lượng</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Linh kiện">
                                    <MudText Typo="Typo.body2" Style="font-weight:600;">@context.ComponentName</MudText>
                                </MudTd>
                                <MudTd DataLabel="Sản phẩm">
                                    <MudText Typo="Typo.body2">@context.ProductName</MudText>
                                </MudTd>
                                <MudTd DataLabel="Số lượng" Style="text-align:center;">
                                    <MudText Typo="Typo.body2">@context.Quantity</MudText>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

</MudContainer>

@code {
    // ─── Slot model ───────────────────────────────────────────────────────────
    private class PcSlot
    {
        public int Index { get; init; }
        public string Name { get; init; } = string.Empty;
        public string CategorySlug { get; init; } = string.Empty;
        public BuildPcItemDto? SelectedItem { get; set; }
    }

    private class PresetConfig
    {
        public string Title { get; init; } = string.Empty;
        public List<PresetItem> Items { get; init; } = new();
    }

    private class PresetItem
    {
        public string ComponentName { get; init; } = string.Empty;
        public string ProductName { get; init; } = string.Empty;
        public int Quantity { get; init; } = 1;
    }

    // ─── State ───────────────────────────────────────────────────────────────────────────
    private List<PcSlot> _slots = new()
    {
        new() { Index = 1,  Name = "Bộ vi xử lý",        CategorySlug = "cpu" },
        new() { Index = 2,  Name = "Bo mạch chủ",         CategorySlug = "bo-mach-chu" },
        new() { Index = 3,  Name = "RAM",                  CategorySlug = "ram" },
        new() { Index = 4,  Name = "HDD",                  CategorySlug = "hdd" },
        new() { Index = 5,  Name = "SSD",                  CategorySlug = "ssd" },
        new() { Index = 6,  Name = "VGA",                  CategorySlug = "vga" },
        new() { Index = 7,  Name = "Nguồn",                CategorySlug = "nguon" },
        new() { Index = 8,  Name = "Vỏ Case",              CategorySlug = "vo-case" },
        new() { Index = 9,  Name = "Fan Case",             CategorySlug = "fan-case" },
        new() { Index = 10, Name = "Màn hình",             CategorySlug = "man-hinh" },
        new() { Index = 11, Name = "Chuột",                CategorySlug = "chuot" },
        new() { Index = 12, Name = "Bàn phím",             CategorySlug = "ban-phim" },
        new() { Index = 13, Name = "Tản nhiệt khí",        CategorySlug = "tan-nhiet-khi" },
        new() { Index = 14, Name = "Tản nhiệt nước AIO",   CategorySlug = "tan-nhiet-nuoc-aio" },
        new() { Index = 15, Name = "Tai nghe",             CategorySlug = "tai-nghe" },
        new() { Index = 16, Name = "Phần mềm",             CategorySlug = "phan-mem" },
    };

    private static readonly List<PresetConfig> _presets = new()
    {
        new()
        {
            Title = "Cấu hình PC Intel Văn Phòng",
            Items = new()
            {
                new() { ComponentName = "CPU",         ProductName = "Intel Core i5-12400",          Quantity = 1 },
                new() { ComponentName = "Bo mạch chủ", ProductName = "ASUS Prime H610M-K D4",         Quantity = 1 },
                new() { ComponentName = "RAM",         ProductName = "Kingston 8GB DDR4 3200MHz",     Quantity = 2 },
                new() { ComponentName = "SSD",         ProductName = "Kingston NV2 500GB NVMe",       Quantity = 1 },
                new() { ComponentName = "VGA",         ProductName = "Intel UHD Graphics 730 (tích hợp)", Quantity = 1 },
                new() { ComponentName = "Nguồn",       ProductName = "Corsair CV550 550W 80+ Bronze", Quantity = 1 },
                new() { ComponentName = "Vỏ Case",     ProductName = "Xigmatek Gemini M",             Quantity = 1 },
                new() { ComponentName = "Màn hình",    ProductName = "Dell E2422H 24\" FHD IPS",      Quantity = 1 },
            }
        },
        new()
        {
            Title = "Cấu hình PC AMD Gaming Tầm Trung",
            Items = new()
            {
                new() { ComponentName = "CPU",         ProductName = "AMD Ryzen 5 5600X",            Quantity = 1 },
                new() { ComponentName = "Bo mạch chủ", ProductName = "MSI B550M Pro-VDH WiFi",         Quantity = 1 },
                new() { ComponentName = "RAM",         ProductName = "G.Skill Ripjaws V 16GB DDR4 3600", Quantity = 1 },
                new() { ComponentName = "SSD",         ProductName = "Samsung 870 EVO 1TB SATA",      Quantity = 1 },
                new() { ComponentName = "VGA",         ProductName = "MSI RX 6600 MECH 2X 8GB",      Quantity = 1 },
                new() { ComponentName = "Nguồn",       ProductName = "Seasonic Focus GX-650 80+ Gold",Quantity = 1 },
                new() { ComponentName = "Vỏ Case",     ProductName = "NZXT H510 Mid Tower",           Quantity = 1 },
                new() { ComponentName = "Tản nhiệt",   ProductName = "DeepCool AK400",                Quantity = 1 },
                new() { ComponentName = "Màn hình",    ProductName = "AOC 27G2 27\" FHD 144Hz IPS",  Quantity = 1 },
            }
        },
        new()
        {
            Title = "Cấu hình PC Gaming Hi-End",
            Items = new()
            {
                new() { ComponentName = "CPU",         ProductName = "Intel Core i7-13700K",          Quantity = 1 },
                new() { ComponentName = "Bo mạch chủ", ProductName = "ASUS ROG Strix Z790-F Gaming",   Quantity = 1 },
                new() { ComponentName = "RAM",         ProductName = "Corsair Vengeance 32GB DDR5 6000",Quantity = 1 },
                new() { ComponentName = "SSD",         ProductName = "Samsung 990 Pro 2TB NVMe PCIe 4.0",Quantity = 1 },
                new() { ComponentName = "VGA",         ProductName = "ASUS TUF RTX 4070 Ti 12GB",     Quantity = 1 },
                new() { ComponentName = "Nguồn",       ProductName = "Corsair RM1000x 1000W 80+ Gold",Quantity = 1 },
                new() { ComponentName = "Vỏ Case",     ProductName = "Lian Li PC-O11 Dynamic EVO XL", Quantity = 1 },
                new() { ComponentName = "Tản nhiệt AIO",ProductName = "NZXT Kraken 360 AIO 360mm",    Quantity = 1 },
                new() { ComponentName = "Màn hình",    ProductName = "LG 32GQ850 32\" QHD 240Hz Nano IPS", Quantity = 1 },
            }
        },
        new()
        {
            Title = "Cấu hình PC Đồ Họa / Workstation",
            Items = new()
            {
                new() { ComponentName = "CPU",         ProductName = "AMD Ryzen 9 7950X",             Quantity = 1 },
                new() { ComponentName = "Bo mạch chủ", ProductName = "ASUS ProArt X670E-Creator WiFi", Quantity = 1 },
                new() { ComponentName = "RAM",         ProductName = "Kingston Fury Beast 64GB DDR5 5200",Quantity = 1 },
                new() { ComponentName = "SSD",         ProductName = "WD Black SN850X 2TB NVMe",      Quantity = 2 },
                new() { ComponentName = "VGA",         ProductName = "NVIDIA RTX 4080 16GB",          Quantity = 1 },
                new() { ComponentName = "Nguồn",       ProductName = "be quiet! Dark Power 13 1000W", Quantity = 1 },
                new() { ComponentName = "Vỏ Case",     ProductName = "Fractal Design Define 7 XL",    Quantity = 1 },
                new() { ComponentName = "Tản nhiệt AIO",ProductName = "Corsair iCUE H150i Elite 360mm",Quantity = 1 },
                new() { ComponentName = "Màn hình",    ProductName = "ASUS ProArt PA329CV 32\" 4K IPS", Quantity = 1 },
            }
        },
    };

    private bool _isExporting = false;
    private bool _isAddingToCart = false;

    private decimal TotalCost =>
        _slots.Where(s => s.SelectedItem != null)
              .Sum(s => s.SelectedItem!.UnitPrice * s.SelectedItem.Quantity);

    private bool HasAnyItem => _slots.Any(s => s.SelectedItem != null);

    // ─── Actions ──────────────────────────────────────────────────────────────
    private async Task OpenPicker(PcSlot slot)
    {
        var parameters = new DialogParameters
        {
            [nameof(ComponentPickerDialog.SlotName)] = slot.Name,
            [nameof(ComponentPickerDialog.CategorySlug)] = slot.CategorySlug
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<ComponentPickerDialog>(
            $"Chọn {slot.Name}", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is BuildPcItemDto item)
        {
            item.SlotIndex = slot.Index;
            item.SlotName = slot.Name;
            slot.SelectedItem = item;
            StateHasChanged();
        }
    }

    private void RemoveItem(PcSlot slot)
    {
        slot.SelectedItem = null;
    }

    private void UpdateQuantity(PcSlot slot, int qty)
    {
        if (slot.SelectedItem == null) return;
        slot.SelectedItem.Quantity = Math.Clamp(qty, 1, 10);
    }

    private void ResetAll()
    {
        foreach (var slot in _slots)
            slot.SelectedItem = null;
    }

    private async Task ExportExcel()
    {
        _isExporting = true;
        try
        {
            var request = new ExportBuildPcRequest
            {
                Items = _slots
                    .Where(s => s.SelectedItem != null)
                    .Select(s => s.SelectedItem!)
                    .ToList()
            };
            await BuildPcService.ExportBuildPcAsync(request);
        }
        catch
        {
            Snackbar.Add("Không thể xuất file Excel.", Severity.Error);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task AddAllToCart()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login?returnUrl=/build-pc");
            return;
        }

        _isAddingToCart = true;
        int added = 0;
        int failed = 0;

        foreach (var slot in _slots.Where(s => s.SelectedItem != null))
        {
            var item = slot.SelectedItem!;
            var result = await CartService.AddToCartAsync(item.VariantId, item.Quantity);

            if (result.Success) added++;
            else failed++;
        }

        _isAddingToCart = false;

        if (failed == 0)
        {
            Snackbar.Add($"Đã thêm {added} linh kiện vào giỏ hàng.", Severity.Success);
            Navigation.NavigateTo("/cart");
        }
        else
        {
            Snackbar.Add($"Thêm thành công {added}, thất bại {failed} linh kiện.", Severity.Warning);
        }
    }
}

<style>
    .build-pc-row {
        display: flex;
        align-items: center;
        min-height: 64px;
        transition: background .15s;
    }

    .build-pc-row:hover {
        background: rgba(0, 0, 0, .02);
    }

    .slot-label {
        width: 220px;
        flex-shrink: 0;
        padding: 12px 16px;
        border-right: 1px solid rgba(0, 0, 0, .08);
        background: rgba(0, 0, 0, .02);
    }

    .slot-content {
        flex: 1;
        padding: 12px 16px;
        display: flex;
        align-items: center;
    }

    .build-pc-header-row {
        min-height: 48px;
        background: rgba(0, 0, 0, .04);
    }

    .build-pc-header-content,
    .slot-selected-item {
        display: flex;
        align-items: center;
        width: 100%;
    }

    .slot-col-name    { flex: 1; }
    .slot-col-qty     { width: 110px; flex-shrink: 0; display: flex; justify-content: center; }
    .slot-col-price   { width: 130px; flex-shrink: 0; text-align: right; }
    .slot-col-total   { width: 140px; flex-shrink: 0; text-align: right; }
    .slot-col-actions { width: 90px;  flex-shrink: 0; }
</style>
