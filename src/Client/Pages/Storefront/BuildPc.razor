@page "/build-pc"
@layout StorefrontLayout
@using PBL3.Shared.DTOs.BuildPc
@using Client.Services.BuildPc
@using Client.Services.Cart
@inject IBuildPcClientService BuildPcService
@inject ICartClientService CartService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Xây dựng PC - HushStore</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-10">

    @* ── Header ── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h5" Style="font-weight:700;">
            Build PC - Chọn linh kiện xây dựng cấu hình
        </MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="ResetAll">
            LÀM MỚI
        </MudButton>
    </MudStack>

    @* ── Cost estimate (top) ── *@
    <div class="d-flex justify-end mb-3">
        <MudText Typo="Typo.subtitle1">
            Chi phí dự tính:
            <strong style="color:#c0392b; font-size:1.2rem;">@TotalCost.ToString("N0")đ</strong>
        </MudText>
    </div>

    @* ── Component table ── *@
    <MudPaper Elevation="2" Class="rounded-lg overflow-hidden">

        @* Column header — chỉ hiện khi có ít nhất 1 slot đã chọn *@
        @if (HasAnyItem)
        {
            <div class="build-pc-header-row d-flex align-center">
                <div class="slot-label" style="visibility:hidden;"></div>
                <div class="slot-content build-pc-header-content">
                    <div style="flex:1; font-weight:700;">Tên sản phẩm</div>
                    <div style="width:110px; font-weight:700; text-align:center;">Số lượng</div>
                    <div style="width:130px; font-weight:700; text-align:right;">Đơn giá</div>
                    <div style="width:140px; font-weight:700; text-align:right;">Thành tiền</div>
                    <div style="width:90px;"></div>
                </div>
            </div>
            <MudDivider />
        }

        @* Tất cả 16 slot theo thứ tự cố định *@
        @foreach (var slot in _slots)
        {
            <div class="build-pc-row d-flex align-center">
                <div class="slot-label">
                    <MudText Typo="Typo.body1" Style="font-weight:600;">
                        @slot.Index. @slot.Name
                    </MudText>
                </div>
                <div class="slot-content">
                    @if (slot.SelectedItem == null)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="@(() => OpenPicker(slot))">
                            Chọn @slot.Name
                        </MudButton>
                    }
                    else
                    {
                        <div class="slot-selected-item">
                            <div class="slot-col-name d-flex align-center gap-2">
                                @if (!string.IsNullOrEmpty(slot.SelectedItem!.ImageUrl))
                                {
                                    <img src="@slot.SelectedItem!.ImageUrl"
                                         style="width:40px; height:40px; object-fit:contain; flex-shrink:0;" />
                                }
                                <div>
                                    <MudText Typo="Typo.body2" Style="font-weight:600;">@slot.SelectedItem!.ProductName</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@slot.SelectedItem!.VariantName</MudText>
                                    @if (slot.SelectedItem!.WarrantyMonth > 0)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            Bảo hành: @slot.SelectedItem!.WarrantyMonth tháng
                                        </MudText>
                                    }
                                </div>
                            </div>
                            <div class="slot-col-qty">
                                <MudNumericField T="int"
                                                Value="@slot.SelectedItem!.Quantity"
                                                ValueChanged="@(q => UpdateQuantity(slot, q))"
                                                Min="1" Max="10"
                                                Variant="Variant.Outlined"
                                                Margin="Margin.Dense"
                                                Style="width:72px;" />
                            </div>
                            <div class="slot-col-price">
                                <MudText Typo="Typo.body2" Style="white-space:nowrap;">
                                    @slot.SelectedItem!.UnitPrice.ToString("N0")đ
                                </MudText>
                            </div>
                            <div class="slot-col-total">
                                <MudText Typo="Typo.body2" Color="Color.Error"
                                         Style="font-weight:700; white-space:nowrap;">
                                    @((slot.SelectedItem!.UnitPrice * slot.SelectedItem!.Quantity).ToString("N0"))đ
                                </MudText>
                            </div>
                            <div class="slot-col-actions d-flex gap-1 justify-end">
                                <MudTooltip Text="Thay đổi linh kiện">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                                   Size="Size.Small" Color="Color.Primary"
                                                   OnClick="@(() => OpenPicker(slot))" />
                                </MudTooltip>
                                <MudTooltip Text="Xóa">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => RemoveItem(slot))" />
                                </MudTooltip>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <MudDivider />
        }

    </MudPaper>

    @* ── Cost estimate (bottom) ── *@
    <div class="d-flex justify-end mt-3 mb-5">
        <MudText Typo="Typo.subtitle1">
            Chi phí dự tính:
            <strong style="color:#c0392b; font-size:1.2rem;">@TotalCost.ToString("N0")đ</strong>
        </MudText>
    </div>

    @* ── Action buttons ── *@
    <MudStack Row="true" Spacing="2" Class="mb-10">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.SaveAlt"
                   OnClick="ExportExcel"
                   Disabled="@(_isExporting || !HasAnyItem)">
            @if (_isExporting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            LƯU CẤU HÌNH
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ShoppingCart"
                   OnClick="AddAllToCart"
                   Disabled="@(_isAddingToCart || !HasAnyItem)">
            @if (_isAddingToCart)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            THÊM VÀO GIỎ HÀNG
        </MudButton>
    </MudStack>


</MudContainer>

@code {
    // ─── Slot model ───────────────────────────────────────────────────────────
    private class PcSlot
    {
        public int Index { get; init; }
        public string Name { get; init; } = string.Empty;
        public string CategorySlug { get; init; } = string.Empty;
        public BuildPcItemDto? SelectedItem { get; set; }
    }

    // ─── State ───────────────────────────────────────────────────────────────────────────
    private List<PcSlot> _slots = new()
    {
        new() { Index = 1,  Name = "Bộ vi xử lý",        CategorySlug = "cpu" },
        new() { Index = 2,  Name = "Bo mạch chủ",         CategorySlug = "bo-mach-chu" },
        new() { Index = 3,  Name = "RAM",                  CategorySlug = "ram" },
        new() { Index = 4,  Name = "HDD",                  CategorySlug = "hdd" },
        new() { Index = 5,  Name = "SSD",                  CategorySlug = "ssd" },
        new() { Index = 6,  Name = "VGA",                  CategorySlug = "vga" },
        new() { Index = 7,  Name = "Nguồn",                CategorySlug = "nguon" },
        new() { Index = 8,  Name = "Vỏ Case",              CategorySlug = "vo-case" },
        new() { Index = 9,  Name = "Fan Case",             CategorySlug = "fan-case" },
        new() { Index = 10, Name = "Màn hình",             CategorySlug = "man-hinh" },
        new() { Index = 11, Name = "Chuột",                CategorySlug = "chuot" },
        new() { Index = 12, Name = "Bàn phím",             CategorySlug = "ban-phim" },
        new() { Index = 13, Name = "Tản nhiệt khí",        CategorySlug = "tan-nhiet-khi" },
        new() { Index = 14, Name = "Tản nhiệt nước AIO",   CategorySlug = "tan-nhiet-nuoc-aio" },
        new() { Index = 15, Name = "Tai nghe",             CategorySlug = "tai-nghe" },
        new() { Index = 16, Name = "Phần mềm",             CategorySlug = "phan-mem" },
    };

    private bool _isExporting = false;
    private bool _isAddingToCart = false;

    private decimal TotalCost =>
        _slots.Where(s => s.SelectedItem != null)
              .Sum(s => s.SelectedItem!.UnitPrice * s.SelectedItem.Quantity);

    private bool HasAnyItem => _slots.Any(s => s.SelectedItem != null);

    // ─── Actions ──────────────────────────────────────────────────────────────
    private async Task OpenPicker(PcSlot slot)
    {
        var parameters = new DialogParameters
        {
            [nameof(ComponentPickerDialog.SlotName)] = slot.Name,
            [nameof(ComponentPickerDialog.CategorySlug)] = slot.CategorySlug
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<ComponentPickerDialog>(
            $"Chọn {slot.Name}", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is BuildPcItemDto item)
        {
            item.SlotIndex = slot.Index;
            item.SlotName = slot.Name;
            slot.SelectedItem = item;
            StateHasChanged();
        }
    }

    private void RemoveItem(PcSlot slot)
    {
        slot.SelectedItem = null;
    }

    private void UpdateQuantity(PcSlot slot, int qty)
    {
        if (slot.SelectedItem == null) return;
        slot.SelectedItem.Quantity = Math.Clamp(qty, 1, 10);
    }

    private void ResetAll()
    {
        foreach (var slot in _slots)
            slot.SelectedItem = null;
    }

    private async Task ExportExcel()
    {
        _isExporting = true;
        try
        {
            var request = new ExportBuildPcRequest
            {
                Items = _slots
                    .Where(s => s.SelectedItem != null)
                    .Select(s => s.SelectedItem!)
                    .ToList()
            };
            await BuildPcService.ExportBuildPcAsync(request);
        }
        catch
        {
            Snackbar.Add("Không thể xuất file Excel.", Severity.Error);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task AddAllToCart()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login?returnUrl=/build-pc");
            return;
        }

        _isAddingToCart = true;
        int added = 0;
        int failed = 0;

        foreach (var slot in _slots.Where(s => s.SelectedItem != null))
        {
            var item = slot.SelectedItem!;
            var result = await CartService.AddToCartAsync(item.VariantId, item.Quantity);

            if (result.Success) added++;
            else failed++;
        }

        _isAddingToCart = false;

        if (failed == 0)
        {
            Snackbar.Add($"Đã thêm {added} linh kiện vào giỏ hàng.", Severity.Success);
            Navigation.NavigateTo("/cart");
        }
        else
        {
            Snackbar.Add($"Thêm thành công {added}, thất bại {failed} linh kiện.", Severity.Warning);
        }
    }
}

<style>
    .build-pc-row {
        display: flex;
        align-items: center;
        min-height: 64px;
        transition: background .15s;
    }

    .build-pc-row:hover {
        background: rgba(0, 0, 0, .02);
    }

    .slot-label {
        width: 220px;
        flex-shrink: 0;
        padding: 12px 16px;
        border-right: 1px solid rgba(0, 0, 0, .08);
        background: rgba(0, 0, 0, .02);
    }

    .slot-content {
        flex: 1;
        padding: 12px 16px;
        display: flex;
        align-items: center;
    }

    .build-pc-header-row {
        min-height: 48px;
        background: rgba(0, 0, 0, .04);
    }

    .build-pc-header-content,
    .slot-selected-item {
        display: flex;
        align-items: center;
        width: 100%;
    }

    .slot-col-name    { flex: 1; }
    .slot-col-qty     { width: 110px; flex-shrink: 0; display: flex; justify-content: center; }
    .slot-col-price   { width: 130px; flex-shrink: 0; text-align: right; }
    .slot-col-total   { width: 140px; flex-shrink: 0; text-align: right; }
    .slot-col-actions { width: 90px;  flex-shrink: 0; }
</style>
