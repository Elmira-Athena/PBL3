@page "/admin/products/create"
@page "/admin/products/edit/{Id:int}"

<PageTitle>@(_isEditMode ? "Chỉnh sửa sản phẩm" : "Thêm sản phẩm mới") - HushStore</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-2 mb-6">
    @* ===== HEADER ===== *@
    <MudPaper Elevation="0" Class="d-flex align-center justify-space-between mb-4 pa-0">
        <div>
            <MudText Typo="Typo.h5" Class="fw-bold" Style="color: var(--mud-palette-text-primary);">
                @(_isEditMode ? "Chỉnh sửa sản phẩm" : "Thêm sản phẩm mới")
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @(_isEditMode ? "Cập nhật thông tin sản phẩm và biến thể (mỗi biến thể có ảnh + thông số riêng)" : "Nhập đầy đủ thông tin sản phẩm")
            </MudText>
        </div>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Href="/admin/products"
                       Style="text-transform: none; border-radius: 8px;">
                Hủy
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="HandleSubmit"
                       Disabled="_isSaving"
                       Style="text-transform: none; border-radius: 8px; font-weight: 500;">
                @if (_isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                }
                @(_isEditMode ? "Cập nhật" : "Tạo sản phẩm")
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (_isLoadingDetail)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="400px" Class="rounded-lg" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Class="rounded-lg" />
            </MudItem>
        </MudGrid>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <MudGrid>
                @* ===== CỘT TRÁI (8/12) – Thông tin chung ===== *@
                <MudItem xs="12" md="8">
                    @* -- Thông tin chung -- *@
                    <MudPaper Elevation="1" Class="pa-5 rounded-lg mb-4">
                        <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight: 600;">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Class="me-1" Size="Size.Small" />
                            Thông tin chung
                        </MudText>

                        <MudTextField @bind-Value="_model.Name"
                                      Label="Tên sản phẩm *"
                                      Placeholder="VD: Laptop Asus ExpertBook"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="mb-3"
                                      Required="true"
                                      RequiredError="Tên sản phẩm không được để trống." />

                        <MudTextField @bind-Value="_model.ShortDescription"
                                      Label="Mô tả ngắn"
                                      Placeholder="Tóm tắt nổi bật của sản phẩm"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="2"
                                      Class="mb-3" />

                        <MudTextField @bind-Value="_model.Description"
                                      Label="Mô tả chi tiết (dùng chung cho mọi biến thể)"
                                      Placeholder="Nhập mô tả sản phẩm"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="5" />
                    </MudPaper>
                </MudItem>

                @* ===== CỘT PHẢI (4/12) – Phân loại ===== *@
                <MudItem xs="12" md="4">
                    @* -- Phân loại -- *@
                    <MudPaper Elevation="1" Class="pa-5 rounded-lg mb-4">
                        <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight: 600;">
                            <MudIcon Icon="@Icons.Material.Filled.Category" Class="me-1" Size="Size.Small" />
                            Phân loại
                        </MudText>

                        <MudSelect @bind-Value="_model.CategoryId"
                                   Label="Danh mục *"
                                   Placeholder="-- Chọn danh mục --"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="mb-3"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Required="true"
                                   RequiredError="Vui lòng chọn danh mục.">
                            @if (_categories != null)
                            {
                                @foreach (var cat in FlattenCategories(_categories))
                                {
                                    <MudSelectItem Value="@cat.Id">
                                        @(new string('—', cat.Level) + " " + cat.Name)
                                    </MudSelectItem>
                                }
                            }
                        </MudSelect>

                        <MudSelect @bind-Value="_model.ManufacturerId"
                                   Label="Hãng sản xuất *"
                                   Placeholder="-- Chọn hãng sản xuất --"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="mb-3"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Required="true"
                                   RequiredError="Vui lòng chọn hãng sản xuất."
                                   Disabled="_isLoadingManufacturers">
                            @if (_isLoadingManufacturers)
                            {
                                <MudSelectItem Value="0" Disabled="true">Đang tải...</MudSelectItem>
                            }
                            else
                            {
                                @foreach (var mf in _manufacturers)
                                {
                                    <MudSelectItem Value="@mf.Id">
                                        <div class="d-flex align-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(mf.LogoUrl))
                                            {
                                                <MudAvatar Size="Size.Small" Style="border-radius: 4px; width:20px; height:20px;">
                                                    <MudImage Src="@mf.LogoUrl" Alt="@mf.Name" />
                                                </MudAvatar>
                                            }
                                            @mf.Name
                                        </div>
                                    </MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudPaper>

                    @* -- Trạng thái (chỉ hiện khi Edit) -- *@
                    @if (_isEditMode)
                    {
                        <MudPaper Elevation="1" Class="pa-5 rounded-lg mb-4">
                            <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight: 600;">
                                <MudIcon Icon="@Icons.Material.Filled.ToggleOn" Class="me-1" Size="Size.Small" />
                                Trạng thái
                            </MudText>

                            <MudSelect @bind-Value="_statusForUpdate"
                                       Label="Trạng thái"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter">
                                <MudSelectItem Value="ProductStatus.Draft">Nháp</MudSelectItem>
                                <MudSelectItem Value="ProductStatus.Active">Đang bán</MudSelectItem>
                                <MudSelectItem Value="ProductStatus.StopBusiness">Ngừng kinh doanh</MudSelectItem>
                            </MudSelect>
                        </MudPaper>
                    }

                    @* -- Thông tin nhanh (chỉ hiện khi Edit) -- *@
                    @if (_isEditMode && _editDetail != null)
                    {
                        <MudPaper Elevation="1" Class="pa-5 rounded-lg mb-4">
                            <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight: 600;">
                                <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="me-1" Size="Size.Small" />
                                Thông tin
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-1">
                                <strong>ID:</strong> @_editDetail.Id
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-1">
                                <strong>Ngày tạo:</strong> @_editDetail.CreatedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </MudText>
                            <MudText Typo="Typo.body2">
                                <strong>Số biến thể:</strong> @_model.Variants.Count
                            </MudText>
                        </MudPaper>
                    }
                </MudItem>

                @* ===== PHẦN DƯỚI – Danh sách biến thể ===== *@
                <MudItem xs="12">
                    <MudPaper Elevation="1" Class="pa-5 rounded-lg">
                        <div class="d-flex align-center justify-space-between mb-3">
                            <MudText Typo="Typo.h6" Style="font-weight: 600;">
                                <MudIcon Icon="@Icons.Material.Filled.ViewModule" Class="me-1" Size="Size.Small" />
                                Danh sách biến thể
                            </MudText>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Size="Size.Small"
                                       OnClick="AddVariant"
                                       Style="text-transform: none; border-radius: 8px;">
                                Thêm biến thể
                            </MudButton>
                        </div>

                        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">
                            Mỗi biến thể có ảnh và thông số kỹ thuật riêng. Sản phẩm bắt buộc có ít nhất 1 biến thể.
                        </MudText>

                        @if (_model.Variants.Count == 0)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="rounded-lg">
                                Chưa có biến thể nào. Vui lòng thêm ít nhất 1 biến thể.
                            </MudAlert>
                        }
                        else
                        {
                            @for (int i = 0; i < _model.Variants.Count; i++)
                            {
                                var index = i;
                                var variantKey = GetVariantKey(index);
                                <MudPaper Outlined="true" Class="pa-4 rounded-lg mb-4" Style="border-color: var(--mud-palette-lines-default);">
                                    <div class="d-flex align-center justify-space-between mb-3">
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">
                                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Class="me-1" />
                                            Biến thể @(index + 1) @(string.IsNullOrWhiteSpace(_model.Variants[index].VariantName) ? "" : $"— {_model.Variants[index].VariantName}")
                                        </MudText>
                                        @if (_model.Variants.Count > 1)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="@(() => RemoveVariant(index))" />
                                        }
                                    </div>

                                    <MudGrid>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField @bind-Value="_model.Variants[index].SKU"
                                                          Label="Mã SKU *"
                                                          Placeholder="VD: LAP1010-01"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Required="true"
                                                          RequiredError="SKU không được để trống." />
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField @bind-Value="_model.Variants[index].VariantName"
                                                          Label="Tên phiên bản *"
                                                          Placeholder="VD: Core i5 / 8GB RAM"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Required="true"
                                                          RequiredError="Tên phiên bản không được để trống." />
                                        </MudItem>
                                        <MudItem xs="12" sm="4" md="2">
                                            <MudNumericField @bind-Value="_model.Variants[index].Price"
                                                             Label="Giá bán *"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Min="0m"
                                                             Format="N0"
                                                             Adornment="Adornment.End"
                                                             AdornmentText="đ" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4" md="2">
                                            <MudNumericField @bind-Value="_model.Variants[index].OriginalPrice"
                                                             Label="Giá gốc"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Min="0m"
                                                             Format="N0"
                                                             Adornment="Adornment.End"
                                                             AdornmentText="đ" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4" md="2">
                                            <MudNumericField @bind-Value="_model.Variants[index].WarrantyMonth"
                                                             Label="Bảo hành (tháng)"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Min="0" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudDivider Class="my-3" />

                                    <MudGrid>
                                        <MudItem xs="12" md="6">
                                            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight: 600;">
                                                <MudIcon Icon="@Icons.Material.Filled.Image" Class="me-1" Size="Size.Small" />
                                                Hình ảnh
                                            </MudText>
                                            <VariantImageEditor EditorKey="@variantKey"
                                                                Images="_model.Variants[index].Images"
                                                                ImagesChanged="@(imgs => OnVariantImagesChanged(index, imgs))" />
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <VariantSpecsEditor Specifications="_model.Variants[index].Specifications"
                                                                SpecificationsChanged="@(s => OnVariantSpecsChanged(index, s))" />
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </EditForm>
    }
</MudContainer>

@code {
    [Parameter] public int? Id { get; set; }

    [Inject] private IProductClientService ProductService { get; set; } = null!;
    [Inject] private ICategoryClientService CategoryService { get; set; } = null!;
    [Inject] private IManufacturerClientService ManufacturerService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    // ===== STATE =====
    private bool _isEditMode => Id.HasValue;
    private bool _isLoadingDetail;
    private bool _isSaving;

    private CreateProductRequest _model = new()
    {
        Variants = new List<CreateVariantRequest>
        {
            new CreateVariantRequest { WarrantyMonth = 12, Specifications = new() }
        }
    };

    // Map index → VariantId hiện có (chỉ tồn tại khi Edit). Variant mới thêm trong Edit mode sẽ không có Id.
    private readonly Dictionary<int, int> _existingVariantIds = new();

    private ProductDetailDto? _editDetail;
    private ProductStatus _statusForUpdate = ProductStatus.Draft;

    private List<CategoryTreeDto>? _categories;

    private List<ManufacturerSummaryDto> _manufacturers = new();
    private bool _isLoadingManufacturers;

    protected override async Task OnInitializedAsync()
    {
        _isLoadingManufacturers = true;
        var catTask = CategoryService.GetTreeAsync();
        var mfTask = ManufacturerService.GetDropdownAsync();

        await Task.WhenAll(catTask, mfTask);

        var catResult = await catTask;
        if (catResult.Success && catResult.Data != null)
            _categories = catResult.Data;

        var mfResult = await mfTask;
        if (mfResult.Success && mfResult.Data != null)
            _manufacturers = mfResult.Data;

        _isLoadingManufacturers = false;

        if (_isEditMode)
        {
            await LoadProductForEdit();
        }
    }

    private async Task LoadProductForEdit()
    {
        _isLoadingDetail = true;
        StateHasChanged();

        var result = await ProductService.GetByIdAsync(Id!.Value);

        if (result.Success && result.Data != null)
        {
            _editDetail = result.Data;
            _existingVariantIds.Clear();

            _model = new CreateProductRequest
            {
                Name = _editDetail.Name,
                ShortDescription = _editDetail.ShortDescription,
                Description = _editDetail.Description,
                ManufacturerId = _editDetail.ManufacturerId,
                CategoryId = _editDetail.CategoryId,
                Variants = _editDetail.Variants.Select((v, idx) =>
                {
                    _existingVariantIds[idx] = v.Id;
                    return new CreateVariantRequest
                    {
                        SKU = v.SKU,
                        VariantName = v.VariantName,
                        Price = v.Price,
                        OriginalPrice = v.OriginalPrice,
                        WarrantyMonth = v.WarrantyMonth,
                        Specifications = v.Specifications != null
                            ? new Dictionary<string, string>(v.Specifications)
                            : new(),
                        Images = v.Images?.OrderByDescending(i => i.IsMain).ThenBy(i => i.SortOrder)
                            .Select((img, i) => new SaveImageRequest
                            {
                                ImageUrl = img.ImageUrl,
                                IsMain = i == 0,
                                SortOrder = i
                            }).ToList() ?? new()
                    };
                }).ToList()
            };

            _statusForUpdate = _editDetail.Status;
        }
        else
        {
            Snackbar.Add(result.Message, Severity.Error);
            Navigation.NavigateTo("/admin/products");
        }

        _isLoadingDetail = false;
        StateHasChanged();
    }

    // ===== VARIANTS =====

    private string GetVariantKey(int index)
    {
        // Dùng VariantId nếu đã tồn tại (Edit), nếu không dùng index làm key tạm cho file input.
        return _existingVariantIds.TryGetValue(index, out var vid) ? vid.ToString() : $"new_{index}";
    }

    private void AddVariant()
    {
        _model.Variants.Add(new CreateVariantRequest
        {
            WarrantyMonth = 12,
            Specifications = new(),
            Images = new()
        });
    }

    private void RemoveVariant(int index)
    {
        if (_model.Variants.Count <= 1)
        {
            Snackbar.Add("Sản phẩm phải có ít nhất 1 biến thể.", Severity.Warning);
            return;
        }
        _model.Variants.RemoveAt(index);

        // Re-index existing-variant map (key bị shift sau remove)
        var rebuilt = new Dictionary<int, int>();
        int newIdx = 0;
        for (int oldIdx = 0; oldIdx < _model.Variants.Count + 1; oldIdx++)
        {
            if (oldIdx == index) continue;
            if (_existingVariantIds.TryGetValue(oldIdx, out var vid))
                rebuilt[newIdx] = vid;
            newIdx++;
        }
        _existingVariantIds.Clear();
        foreach (var kvp in rebuilt) _existingVariantIds[kvp.Key] = kvp.Value;
    }

    private void OnVariantImagesChanged(int index, List<SaveImageRequest> images)
    {
        _model.Variants[index].Images = images;
    }

    private void OnVariantSpecsChanged(int index, Dictionary<string, string> specs)
    {
        _model.Variants[index].Specifications = specs.Count > 0 ? specs : null;
    }

    // ===== SUBMIT =====

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            Snackbar.Add("Tên sản phẩm không được để trống.", Severity.Warning);
            return;
        }
        if (_model.Variants.Count == 0)
        {
            Snackbar.Add("Sản phẩm phải có ít nhất 1 biến thể.", Severity.Warning);
            return;
        }
        foreach (var v in _model.Variants)
        {
            if (string.IsNullOrWhiteSpace(v.SKU))
            {
                Snackbar.Add("Mã SKU của biến thể không được để trống.", Severity.Warning);
                return;
            }
            if (string.IsNullOrWhiteSpace(v.VariantName))
            {
                Snackbar.Add("Tên phiên bản không được để trống.", Severity.Warning);
                return;
            }
        }
        if (_model.ManufacturerId <= 0)
        {
            Snackbar.Add("Vui lòng chọn hãng sản xuất.", Severity.Warning);
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            if (_isEditMode)
            {
                await SaveEditAsync();
            }
            else
            {
                await SaveCreateAsync();
            }
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task SaveCreateAsync()
    {
        // Đảm bảo mỗi variant có thuộc tính SortOrder/IsMain hợp lệ
        foreach (var v in _model.Variants)
        {
            ReindexImages(v.Images);
        }

        var result = await ProductService.CreateAsync(_model);
        if (result.Success)
        {
            Snackbar.Add("Tạo sản phẩm thành công!", Severity.Success);
            Navigation.NavigateTo("/admin/products");
        }
        else
        {
            Snackbar.Add(result.Message, Severity.Error);
        }
    }

    private async Task SaveEditAsync()
    {
        // 1) Update product metadata
        var productResult = await ProductService.UpdateAsync(Id!.Value, new UpdateProductRequest
        {
            Name = _model.Name,
            ShortDescription = _model.ShortDescription,
            Description = _model.Description,
            ManufacturerId = _model.ManufacturerId,
            CategoryId = _model.CategoryId,
            Status = _statusForUpdate
        });

        if (!productResult.Success)
        {
            Snackbar.Add(productResult.Message, Severity.Error);
            return;
        }

        // 2) Per-variant: nếu có Id thì gọi 3 endpoint variant-scoped, nếu không thì tạo mới
        for (int i = 0; i < _model.Variants.Count; i++)
        {
            var v = _model.Variants[i];
            ReindexImages(v.Images);

            if (_existingVariantIds.TryGetValue(i, out var variantId))
            {
                var metaResult = await ProductService.UpdateVariantAsync(variantId, new UpdateVariantRequest
                {
                    SKU = v.SKU,
                    VariantName = v.VariantName,
                    Price = v.Price,
                    OriginalPrice = v.OriginalPrice,
                    WarrantyMonth = v.WarrantyMonth
                });
                if (!metaResult.Success)
                {
                    Snackbar.Add($"Lưu biến thể #{i + 1} thất bại: {metaResult.Message}", Severity.Warning);
                    continue;
                }

                var imgResult = await ProductService.UpdateVariantImagesAsync(variantId, v.Images);
                if (!imgResult.Success)
                    Snackbar.Add($"Lưu ảnh biến thể #{i + 1} thất bại: {imgResult.Message}", Severity.Warning);

                var specResult = await ProductService.UpdateVariantSpecificationsAsync(
                    variantId,
                    v.Specifications ?? new());
                if (!specResult.Success)
                    Snackbar.Add($"Lưu thông số biến thể #{i + 1} thất bại: {specResult.Message}", Severity.Warning);
            }
            else
            {
                var createResult = await ProductService.CreateVariantAsync(Id!.Value, new SaveVariantRequest
                {
                    SKU = v.SKU,
                    VariantName = v.VariantName,
                    Price = v.Price,
                    OriginalPrice = v.OriginalPrice,
                    WarrantyMonth = v.WarrantyMonth,
                    Specifications = v.Specifications,
                    Images = v.Images
                });
                if (!createResult.Success)
                    Snackbar.Add($"Tạo biến thể mới #{i + 1} thất bại: {createResult.Message}", Severity.Warning);
            }
        }

        // 3) Xoá các variant đã bị remove khỏi UI
        var keptIds = _existingVariantIds.Values.ToHashSet();
        if (_editDetail != null)
        {
            foreach (var original in _editDetail.Variants)
            {
                if (!keptIds.Contains(original.Id))
                {
                    var delResult = await ProductService.DeleteVariantAsync(original.Id);
                    if (!delResult.Success)
                        Snackbar.Add($"Xoá biến thể '{original.VariantName}' thất bại: {delResult.Message}", Severity.Warning);
                }
            }
        }

        Snackbar.Add("Cập nhật sản phẩm thành công!", Severity.Success);
        Navigation.NavigateTo("/admin/products");
    }

    private static void ReindexImages(List<SaveImageRequest> images)
    {
        if (images.Count == 0) return;
        if (!images.Any(i => i.IsMain))
            images[0].IsMain = true;
        for (int i = 0; i < images.Count; i++)
            images[i].SortOrder = i;
    }

    // ===== HELPERS =====

    private List<CategoryTreeDto> FlattenCategories(List<CategoryTreeDto> cats)
    {
        var result = new List<CategoryTreeDto>();
        foreach (var cat in cats)
        {
            result.Add(cat);
            if (cat.Children.Count > 0)
                result.AddRange(FlattenCategories(cat.Children));
        }
        return result;
    }
}
