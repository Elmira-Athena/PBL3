@page "/"
@layout StorefrontLayout
@using PBL3.Shared.DTOs.Storefront
@using Client.Services.Storefront
@using Client.Shared.Components.Storefront
@inject IStorefrontClientService StorefrontService
@inject IBannerClientService BannerService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>HushStore - Trang chủ</PageTitle>

@if (_isLoading)
{
    <div style="background-color: #f5f5f5; padding: 16px 0;">
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="400px" />
                </MudItem>
                <MudItem xs="12" md="9">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="400px" />
                </MudItem>
            </MudGrid>
        </MudContainer>
    </div>
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Class="mt-4" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Class="mt-4" />
    </MudContainer>
}
else
{
    <!-- Banner Section: Full-width -->
    <div style="background-color: #f5f5f5; padding: 16px 0;">
        <MudContainer MaxWidth="MaxWidth.Large">
            <MudGrid>
                <MudItem xs="12" md="3" Class="mt-4">
                    <MudPaper Elevation="2" Class="pa-0 h-100" Style="overflow-y: auto; max-height: 400px;">
                        <MudList T="CategoryMenuResponse" Dense="true" Class="py-2">
                            @foreach (var cat in _categories.Where(c => c.Level == 0).OrderBy(c => c.Name))
                            {
                                var hasChildren = _categories.Any(c => c.ParentId == cat.Id);
                                var isExpanded = _expandedCategoryId == cat.Id;

                                <MudListItem T="CategoryMenuResponse" OnClick="@(() => ToggleCategory(cat))">
                                    <div class="d-flex align-center">
                                        @if (!string.IsNullOrEmpty(cat.IconUrl))
                                        {
                                            <img src="@cat.IconUrl" style="width: 24px; height: 24px; object-fit: contain;" class="mr-3" alt="@cat.Name" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" Class="mr-3" />
                                        }
                                        <MudText Typo="Typo.body2">@cat.Name</MudText>
                                        <MudSpacer />
                                        <MudIcon Icon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ChevronRight)"
                                                 Size="Size.Small" />
                                    </div>
                                </MudListItem>

                                @if (isExpanded && hasChildren)
                                {
                                    @foreach (var child in _categories.Where(c => c.ParentId == cat.Id).OrderBy(c => c.Name))
                                    {
                                        <MudListItem T="CategoryMenuResponse" Dense="true" OnClick="@(() => NavigateToCategory(child.Slug))">
                                            <div class="d-flex align-center" style="padding-left: 12px;">
                                                <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight"
                                                         Size="Size.Small" Class="mr-2 mud-text-secondary" />
                                                <MudText Typo="Typo.caption">@child.Name</MudText>
                                            </div>
                                        </MudListItem>
                                    }
                                }
                            }
                        </MudList>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="9" Class="mt-4" Style="padding: 0;">
                    @if (_banners.Count > 0)
                    {
                        <MudCarousel TData="object"
                                     Style="height: 400px; border-radius: 8px; overflow: hidden; display: flex; width: 100%;"
                                     ShowArrows="@(_banners.Count > 1)"
                                     ShowBullets="@(_banners.Count > 1)"
                                     EnableSwipeGesture="true"
                                     AutoCycle="@(_banners.Count > 1)"
                                     AutoCycleTime="TimeSpan.FromSeconds(5)"
                                     Class="mud-elevation-2">
                            @foreach (var b in _banners)
                            {
                                <MudCarouselItem Transition="Transition.Slide">
                                    @if (!string.IsNullOrWhiteSpace(b.LinkUrl))
                                    {
                                        <MudLink Href="@b.LinkUrl" Underline="Underline.None" Class="d-block w-100 h-100">
                                            <img src="@b.ImageUrl" alt="@b.Title"
                                                 style="width: 100%; height: 100%; object-fit: cover; display: block; margin: 0; padding: 0;" />
                                        </MudLink>
                                    }
                                    else
                                    {
                                        <img src="@b.ImageUrl" alt="@b.Title"
                                             style="width: 100%; height: 100%; object-fit: cover; display: block; margin: 0; padding: 0;" />
                                    }
                                </MudCarouselItem>
                            }
                        </MudCarousel>
                    }
                    else
                    {
                        <MudImage Src="@FallbackBannerUrl" ObjectFit="ObjectFit.Cover" Fluid="true" Height="400" Class="rounded-lg w-100" Elevation="2" />
                    }
                </MudItem>
            </MudGrid>
        </MudContainer>
    </div>

    <!-- Main Content -->
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-8">

        <!-- Khối 2+: Sản phẩm nổi bật theo danh mục cấp 0 -->
        @foreach (var featSection in _featuredSections.Where(fs => fs.Products.Any()))
        {
            <div class="mt-8">
                <div class="d-flex align-center justify-space-between mb-4">
                    <MudText Typo="Typo.h5" Class="fw-bold">@featSection.Category.Name nổi bật</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward"
                               OnClick="@(() => NavigateToCategory(featSection.Category.Slug))">
                        Xem tất cả
                    </MudButton>
                </div>
                <MudGrid>
                    @foreach (var product in featSection.Products)
                    {
                        <MudItem xs="12" sm="6" md="4" lg="2">
                            <ProductCard Product="product" />
                        </MudItem>
                    }
                </MudGrid>
            </div>
        }

        <!-- Danh mục sản phẩm Grid (level-0 only) -->
        <div class="mt-8">
            <MudText Typo="Typo.h5" Class="fw-bold mb-4">Danh mục sản phẩm</MudText>
            <MudGrid>
                @foreach (var cat in _categories.Where(c => c.Level == 0).OrderBy(c => c.Name))
                {
                    <MudItem xs="6" sm="4" md="2">
                        <MudPaper Elevation="1" Class="pa-4 d-flex flex-column align-center justify-center h-100" Style="cursor:pointer" @onclick="@(() => NavigateToCategory(cat.Slug))">
                            @if (!string.IsNullOrEmpty(cat.IconUrl))
                            {
                                <img src="@cat.IconUrl" style="width: 48px; height: 48px; object-fit: contain;" class="mb-2" alt="@cat.Name" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Large" Class="mb-2" />
                            }
                            <MudText Typo="Typo.body2" Align="Align.Center">@cat.Name</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </div>

    </MudContainer>

    <!-- Footer -->
    <MudPaper Elevation="0" Class="pa-8 mt-16" Style="background-color: #f5f5f5;">
        <MudContainer MaxWidth="MaxWidth.Large">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold mb-4">HUSH STORE</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">CÔNG TY TNHH HUSH STORE</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2 d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="mr-2" />123 Nguyễn Lương Bằng, Đà Nẵng</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2 d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="mr-2" />0236.3636367</MudText>
                    <MudText Typo="Typo.body2" Class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="mr-2" />hotro@hushstore.vn</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.h6" Class="fw-bold mb-4">SOCIAL</MudText>
                    <div class="d-flex gap-4">
                        <MudIconButton Icon="@Icons.Custom.Brands.Facebook" Color="Color.Info" Size="Size.Large" />
                        <MudIconButton Icon="@Icons.Custom.Brands.Twitter" Color="Color.Info" Size="Size.Large" />
                    </div>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.h6" Class="fw-bold mb-4">Hỗ trợ khách hàng</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2" Style="cursor:pointer" @onclick="HandleComingSoon">Chính sách bảo mật</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2" Style="cursor:pointer" @onclick="HandleComingSoon">Chính sách bảo hành</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2" Style="cursor:pointer" @onclick="HandleComingSoon">Chính sách thanh toán</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2" Style="cursor:pointer" @onclick="HandleComingSoon">Chính sách vận chuyển</MudText>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </MudPaper>
}

@code {
    private const string FallbackBannerUrl = "https://placehold.co/1200x400?text=HushStore+Banner";

    private record CategorySection(CategoryMenuResponse Category, List<ProductCardResponse> Products);

    private bool _isLoading = true;
    private List<CategoryMenuResponse> _categories = new();
    private List<CategorySection> _featuredSections = new();
    private List<BannerPublicDto> _banners = new();
    private int? _expandedCategoryId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;

            var catTask = StorefrontService.GetActiveCategoriesAsync();
            var bannerTask = BannerService.GetActiveAsync();

            await Task.WhenAll(catTask, bannerTask);

            var catResult = await catTask;
            if (catResult.Success && catResult.Data != null)
                _categories = catResult.Data;

            var bannerResult = await bannerTask;
            if (bannerResult.Success && bannerResult.Data != null)
                _banners = bannerResult.Data;

            var level0Cats = _categories.Where(c => c.Level == 0).OrderBy(c => c.Name).ToList();

            var sectionTasks = level0Cats.Select(async cat =>
            {
                var result = await StorefrontService.GetProductsByCategoryAsync(cat.Slug, 1, 6);
                var products = result.Success && result.Data?.Items != null
                    ? result.Data.Items.ToList()
                    : new List<ProductCardResponse>();
                return new CategorySection(cat, products);
            });

            _featuredSections = (await Task.WhenAll(sectionTasks)).ToList();
        }
        catch (Exception)
        {
            Snackbar.Add("Có lỗi xảy ra khi tải dữ liệu", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleCategory(CategoryMenuResponse cat)
    {
        var hasChildren = _categories.Any(c => c.ParentId == cat.Id);
        if (!hasChildren)
        {
            NavigateToCategory(cat.Slug);
            return;
        }
        _expandedCategoryId = _expandedCategoryId == cat.Id ? (int?)null : cat.Id;
    }

    private void HandleComingSoon() =>
        Snackbar.Add("Tính năng đang phát triển", Severity.Info);

    private void NavigateToCategory(string slug) =>
        NavigationManager.NavigateTo($"/category/{slug}");
}
