@inherits LayoutComponentBase
@using Client.Services.Storefront
@using Client.Shared.Components.Storefront
@using PBL3.Shared.DTOs.Storefront
@inject IAuthClientService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@inject IStorefrontClientService StorefrontService

<MudLayout>
    @* ===== TOP APP BAR ===== *@
    <MudAppBar Elevation="2" Dense="false" Fixed="true"
               Style="background: linear-gradient(135deg, #1a1a2e 0%, #c0392b 100%); color: white;">

        @* -- Logo -- *@
        <MudImage Src="images/logo.png" Alt="HushStore"
                  Width="120" Height="40"
                  ObjectFit="ObjectFit.Contain"
                  Class="mr-4" Style="cursor: pointer;"
                  @onclick='() => Navigation.NavigateTo("/")' />

        @* -- DANH MỤC Button with dropdown -- *@
        <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Class="mr-4">
            <ActivatorContent>
                <MudButton Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Menu"
                           Style="background-color: rgba(255,255,255,0.15); color: white; font-weight: 700; letter-spacing: 0.05em; border-radius: 4px;">
                    DANH MỤC
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <div style="max-height: 420px; overflow-y: auto; min-width: 220px;">
                    @foreach (var cat in _menuCategories.OrderBy(c => c.Name))
                    {
                        <MudMenuItem OnClick="@(() => Navigation.NavigateTo($"/category/{cat.Slug}"))">
                            <div class="d-flex align-center">
                                @if (!string.IsNullOrEmpty(cat.IconUrl))
                                {
                                    <img src="@cat.IconUrl" style="width:20px;height:20px;object-fit:contain;" class="mr-2" alt="" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Class="mr-2" Style="opacity:0.4;" />
                                }
                                <MudText Typo="Typo.body2">@cat.Name</MudText>
                            </div>
                        </MudMenuItem>
                    }
                </div>
            </ChildContent>
        </MudMenu>

        @* -- Search Bar -- *@
        <MudPaper Elevation="0" Class="d-flex align-center rounded-lg px-3 flex-grow-1"
                  Style="background-color: white; max-width: 600px;">
            <MudAutocomplete T="ProductCardResponse"
                             @bind-Text="_searchKeyword"
                             ValueChanged="OnProductSelected"
                             SearchFunc="SearchSuggestionsAsync"
                             ToStringFunc="@(p => p?.Name ?? string.Empty)"
                             Placeholder="Nhập từ khóa tìm kiếm..."
                             Variant="Variant.Text"
                             Class="flex-grow-1"
                             Style="font-size: 0.9rem;"
                             Margin="Margin.Dense"
                             Adornment="Adornment.End"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             AdornmentColor="Color.Error"
                             OnAdornmentClick="PerformSearch"
                             OnKeyDown="OnSearchKeyDown"
                             DebounceInterval="400"
                             MinCharacters="2"
                             MaxItems="8"
                             Dense="true"
                             ResetValueOnEmptyText="true"
                             CoerceText="false"
                             CoerceValue="false">
                <ItemTemplate Context="product">
                    <div class="d-flex align-center gap-2 py-1 px-1">
                        @if (!string.IsNullOrEmpty(product.ThumbnailUrl))
                        {
                            <img src="@product.ThumbnailUrl" style="width:36px;height:36px;object-fit:contain;flex-shrink:0;" alt="" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Style="width:36px;opacity:0.4;" />
                        }
                        <div class="d-flex flex-column flex-grow-1 overflow-hidden">
                            <MudText Typo="Typo.body2" Style="font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@product.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@product.ManufacturerName</MudText>
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Error" Style="white-space:nowrap;font-weight:600;margin-left:8px;">
                            @product.CurrentPrice.ToString("N0")₫
                        </MudText>
                    </div>
                </ItemTemplate>
                <NoItemsTemplate>
                    <MudText Typo="Typo.body2" Class="px-4 py-2" Color="Color.Secondary">Không tìm thấy sản phẩm phù hợp</MudText>
                </NoItemsTemplate>
            </MudAutocomplete>
        </MudPaper>
        <MudSpacer />

        @* -- Cart Icon -- *@
        <MudTooltip Text="Giỏ hàng">
            <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart"
                           Color="Color.Inherit"
                           Href="/cart"
                           Size="Size.Medium" />
        </MudTooltip>

        @* -- Build PC Button -- *@
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.Build"
                   Style="color: white; white-space: nowrap;"
                   Href="/build-pc">
            Xây dựng PC
        </MudButton>

        @* -- User Menu -- *@
        <AuthorizeView>
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudAvatar Size="Size.Small" Color="Color.Secondary" Class="cursor-pointer ml-2">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                        </MudAvatar>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Filled.Person">@context.User.Identity?.Name</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.ManageAccounts" OnClick="OpenProfileDialog">Xem hồ sơ</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.ReceiptLong" Href="/my/orders">Đơn hàng của tôi</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Build" Href="/my/service-tickets">Phiếu sửa chữa của tôi</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Đăng xuất</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Text"
                           Style="color: white;"
                           StartIcon="@Icons.Material.Filled.Login"
                           Href="/login">
                    Đăng nhập
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    @* ===== MAIN CONTENT (no sidebar) ===== *@
    <MudMainContent Style="min-height: 100vh; padding-top: 68px !important; background-color: #f5f5f5;">
        @Body
    </MudMainContent>

    <ComparisonTray />
</MudLayout>

@code {
    private string _searchKeyword = string.Empty;
    private List<CategoryMenuResponse> _menuCategories = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                if (user.IsInRole("Admin"))
                {
                    Navigation.NavigateTo("/admin/reports");
                    return;
                }
                else if (user.IsInRole("Employee"))
                {
                    Navigation.NavigateTo("/pos");
                    return;
                }
            }

            var catResult = await StorefrontService.GetActiveCategoriesAsync();
            if (catResult.Success && catResult.Data != null)
                _menuCategories = catResult.Data;
        }
        catch
        {
            // Silently handle — don't break the layout
        }
    }

    private async Task<IEnumerable<ProductCardResponse>> SearchSuggestionsAsync(string keyword, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(keyword) || keyword.Length < 2)
            return [];
        try
        {
            var result = await StorefrontService.SearchProductsAsync(keyword, null, null, null, 1, 8);
            if (result.Success && result.Data != null)
                return result.Data.Items;
        }
        catch { }
        return [];
    }

    private void OnProductSelected(ProductCardResponse? product)
    {
        if (product != null)
            Navigation.NavigateTo($"/product/{product.Slug}");
    }

    private void OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            PerformSearch();
    }

    private void PerformSearch()
    {
        if (!string.IsNullOrWhiteSpace(_searchKeyword))
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(_searchKeyword.Trim())}");
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
    }

    private async Task OpenProfileDialog()
    {
        await DialogService.ShowAsync<UserProfileDialog>(string.Empty,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
    }
}
