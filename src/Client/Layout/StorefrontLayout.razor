@inherits LayoutComponentBase
@implements IDisposable
@using Client.Services.Storefront
@using Client.Shared.Components.Storefront
@using PBL3.Shared.DTOs.Storefront
@inject IAuthClientService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@inject IStorefrontClientService StorefrontService

<MudLayout Style="min-height: 100vh; display: flex; flex-direction: column;">
    @* ===== TOP APP BAR ===== *@
    <MudAppBar Elevation="2" Dense="false" Fixed="true"
               Style="background: linear-gradient(135deg, #1a1a2e 0%, #c0392b 100%); color: white;">

        @* -- Logo -- *@
        <MudImage Src="images/logo.png" Alt="HushStore"
                  Width="120" Height="40"
                  ObjectFit="ObjectFit.Contain"
                  Class="mr-4" Style="cursor: pointer;"
                  @onclick='() => Navigation.NavigateTo("/")' />

        @* -- DANH MỤC Button with dropdown -- *@
        <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Class="mr-4">
            <ActivatorContent>
                <MudButton Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Menu"
                           Style="background-color: rgba(255,255,255,0.15); color: white; font-weight: 700; letter-spacing: 0.05em; border-radius: 4px;">
                    DANH MỤC
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <div style="max-height: 420px; overflow-y: auto; min-width: 220px;">
                    @foreach (var cat in _menuCategories.OrderBy(c => c.Name))
                    {
                        <MudMenuItem OnClick="@(() => Navigation.NavigateTo($"/category/{cat.Slug}"))">
                            <div class="d-flex align-center">
                                @if (!string.IsNullOrEmpty(cat.IconUrl))
                                {
                                    <img src="@cat.IconUrl" style="width:20px;height:20px;object-fit:contain;" class="mr-2" alt="" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Class="mr-2" Style="opacity:0.4;" />
                                }
                                <MudText Typo="Typo.body2">@cat.Name</MudText>
                            </div>
                        </MudMenuItem>
                    }
                </div>
            </ChildContent>
        </MudMenu>

        @* -- Search Bar -- *@
        <MudPaper Elevation="0" Class="d-flex align-center rounded-lg px-3 flex-grow-1"
                  Style="background-color: white; max-width: 600px;">
            <div class="flex-grow-1" style="position:relative;" @onfocusout="@(() => _showSuggestions = false)">
                <MudTextField T="string"
                              Value="@_searchKeyword"
                              ValueChanged="OnSearchInputChanged"
                              Placeholder="Nhập từ khóa tìm kiếm..."
                              Variant="Variant.Text"
                              Class="flex-grow-1"
                              Style="font-size: 0.9rem;"
                              Margin="Margin.Dense"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentColor="Color.Error"
                              OnAdornmentClick="PerformSearch"
                              OnKeyDown="OnSearchKeyDown"
                              Immediate="true" />

                @if (_showSuggestions && _suggestions?.Count > 0)
                {
                    <div class="mud-elevation-8"
                         style="position:absolute;top:100%;left:-12px;right:-12px;z-index:2000;
                                border-radius:0 0 4px 4px;overflow:hidden;
                                background-color:var(--mud-palette-surface);"
                         @onmousedown:preventDefault>
                        <MudList T="ProductCardResponse" Dense="true" Class="pa-0">
                            @foreach (var product in _suggestions)
                            {
                                <MudListItem T="ProductCardResponse" OnClick="@(() => OnProductSelected(product))">
                                    <div class="d-flex align-center gap-2 py-1">
                                        @if (!string.IsNullOrEmpty(product.ThumbnailUrl))
                                        {
                                            <img src="@product.ThumbnailUrl"
                                                 style="width:36px;height:36px;object-fit:contain;flex-shrink:0;" alt="" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Inventory2"
                                                     Size="Size.Small" Style="width:36px;opacity:0.4;" />
                                        }
                                        <div class="d-flex flex-column flex-grow-1 overflow-hidden">
                                            <MudText Typo="Typo.body2"
                                                     Style="font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                                @product.Name
                                            </MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @product.ManufacturerName
                                            </MudText>
                                        </div>
                                        <MudText Typo="Typo.body2" Color="Color.Error"
                                                 Style="white-space:nowrap;font-weight:600;margin-left:8px;">
                                            @product.CurrentPrice.ToString("N0")₫
                                        </MudText>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    </div>
                }
            </div>
        </MudPaper>
        <MudSpacer />

        @* -- Cart Icon -- *@
        <MudTooltip Text="Giỏ hàng">
            <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart"
                           Color="Color.Inherit"
                           Href="/cart"
                           Size="Size.Medium" />
        </MudTooltip>

        @* -- Build PC Button -- *@
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.Build"
                   Style="color: white; white-space: nowrap;"
                   Href="/build-pc">
            Xây dựng PC
        </MudButton>

        @* -- User Menu -- *@
        <AuthorizeView>
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudAvatar Size="Size.Small" Color="Color.Secondary" Class="cursor-pointer ml-2">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                        </MudAvatar>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Filled.Person">@context.User.Identity?.Name</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.ManageAccounts" OnClick="OpenProfileDialog">Xem hồ sơ</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.ReceiptLong" Href="/my/orders">Đơn hàng của tôi</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Build" Href="/my/service-tickets">Phiếu sửa chữa của tôi</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Đăng xuất</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Text"
                           Style="color: white;"
                           StartIcon="@Icons.Material.Filled.Login"
                           Href="/login">
                    Đăng nhập
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    @* ===== MAIN CONTENT (no sidebar) ===== *@
    <MudMainContent Style="flex: 1 0 auto; padding-top: 68px !important; background-color: #f5f5f5;">
        @Body
    </MudMainContent>

    @* ===== FOOTER ===== *@
    <MudPaper Elevation="0" Class="pa-8" Style="background-color: #ebebeb; border-top: 1px solid #ddd;">
        <MudContainer MaxWidth="MaxWidth.Large">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold mb-4">HUSH STORE</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">CÔNG TY TNHH HUSH STORE</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2 d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="mr-2" />123 Nguyễn Lương Bằng, Đà Nẵng</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2 d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="mr-2" />0236.3636367</MudText>
                    <MudText Typo="Typo.body2" Class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="mr-2" />hotro@hushstore.vn</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.h6" Class="fw-bold mb-4">SOCIAL</MudText>
                    <div class="d-flex gap-4">
                        <MudIconButton Icon="@Icons.Custom.Brands.Facebook" Color="Color.Info" Size="Size.Large" />
                        <MudIconButton Icon="@Icons.Custom.Brands.Twitter" Color="Color.Info" Size="Size.Large" />
                    </div>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.h6" Class="fw-bold mb-4">Hỗ trợ khách hàng</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2" Style="cursor:pointer" @onclick="FooterComingSoon">Chính sách bảo mật</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2" Style="cursor:pointer" @onclick="FooterComingSoon">Chính sách bảo hành</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2" Style="cursor:pointer" @onclick="FooterComingSoon">Chính sách thanh toán</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2" Style="cursor:pointer" @onclick="FooterComingSoon">Chính sách vận chuyển</MudText>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </MudPaper>

    <ComparisonTray />
</MudLayout>

@code {
    private string _searchKeyword = string.Empty;
    private List<CategoryMenuResponse> _menuCategories = new();
    private List<ProductCardResponse>? _suggestions;
    private bool _showSuggestions;
    private CancellationTokenSource? _suggestCts;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _searchKeyword = string.Empty;
        _showSuggestions = false;
        _suggestions = null;
        _suggestCts?.Cancel();
        _suggestCts?.Dispose();
        _suggestCts = null;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        _suggestCts?.Cancel();
        _suggestCts?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                if (user.IsInRole("Admin"))
                {
                    Navigation.NavigateTo("/admin/reports");
                    return;
                }
                else if (user.IsInRole("Employee"))
                {
                    Navigation.NavigateTo("/pos");
                    return;
                }
            }

            var catResult = await StorefrontService.GetActiveCategoriesAsync();
            if (catResult.Success && catResult.Data != null)
                _menuCategories = catResult.Data;
        }
        catch
        {
            // Silently handle — don't break the layout
        }
    }

    private async Task OnSearchInputChanged(string value)
    {
        _searchKeyword = value;
        _suggestCts?.Cancel();
        _suggestCts?.Dispose();
        _suggestCts = null;
        if (string.IsNullOrWhiteSpace(value) || value.Length < 2)
        {
            _suggestions = null;
            _showSuggestions = false;
            return;
        }
        _suggestCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, _suggestCts.Token);
            var result = await StorefrontService.SearchProductsAsync(value, null, null, null, 1, 8);
            if (result.Success && result.Data != null)
            {
                _suggestions = result.Data.Items.ToList();
                _showSuggestions = _suggestions.Count > 0;
            }
        }
        catch (OperationCanceledException) { }
    }

    private void OnProductSelected(ProductCardResponse? product)
    {
        _showSuggestions = false;
        if (product != null)
            Navigation.NavigateTo($"/product/{product.Slug}");
    }

    private void OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            PerformSearch();
        else if (args.Key == "Escape")
            _showSuggestions = false;
    }

    private void PerformSearch()
    {
        _showSuggestions = false;
        if (!string.IsNullOrWhiteSpace(_searchKeyword))
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(_searchKeyword.Trim())}");
    }

    private void FooterComingSoon() =>
        Snackbar.Add("Tính năng đang phát triển", Severity.Info);

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
    }

    private async Task OpenProfileDialog()
    {
        await DialogService.ShowAsync<UserProfileDialog>(string.Empty,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
    }
}
