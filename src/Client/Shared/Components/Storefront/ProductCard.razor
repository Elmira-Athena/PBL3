@using PBL3.Shared.DTOs.Storefront
@inject ISnackbar Snackbar

<MudCard Elevation="2" Class="pa-2 rounded-lg position-relative d-flex flex-column h-100" Style="cursor:pointer;" @onclick="HandleClick">
    @if (Product.DiscountPercent > 0)
    {
        <MudBadge Content="@($"-{Product.DiscountPercent}%")" Color="Color.Error" Overlap="true" Class="position-absolute" Style="top: 10px; right: 10px; z-index: 1;" />
    }

    <div class="d-flex justify-center align-center" style="height: 180px;">
        @if (!string.IsNullOrEmpty(Product.ThumbnailUrl))
        {
            <MudImage Src="@Product.ThumbnailUrl" ObjectFit="ObjectFit.Contain" Style="max-height: 100%; max-width: 100%;" />
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" Color="Color.Surface" />
        }
    </div>

    <MudCardContent Class="pa-2 flex-grow-1 d-flex flex-column">
        <MudText Typo="Typo.body2" Class="fw-bold mb-1" Style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 40px;">
            @Product.Name
        </MudText>
        
        <div class="mt-auto">
            @if (Product.DiscountPercent > 0)
            {
                <MudText Typo="Typo.caption" Style="text-decoration: line-through;" Color="Color.Default">
                    @Product.OldPrice.ToString("N0")đ
                </MudText>
            }
            <MudText Typo="Typo.h6" Color="Color.Error" Class="fw-bold">
                @Product.CurrentPrice.ToString("N0")đ
            </MudText>

            <div class="d-flex align-center mt-1">
                <MudRating SelectedValue="(int)Product.Rating" Max="5" Size="Size.Small" ReadOnly="true" />
                <MudText Typo="Typo.caption" Class="ml-1">(@Product.ReviewCount đánh giá)</MudText>
            </div>
        </div>
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public ProductCardResponse Product { get; set; } = default!;

    private void HandleClick()
    {
        Snackbar.Add("Tính năng đang phát triển", Severity.Info);
    }
}
