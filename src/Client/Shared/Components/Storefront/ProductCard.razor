@using PBL3.Shared.DTOs.Storefront
@using Client.Services.Comparison
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IComparisonService ComparisonService

<div class="hs-card" style="cursor:pointer; height:100%; display:flex; flex-direction:column; position:relative;" @onclick="HandleClick">

    @* Discount badge *@
    @if (Product.DiscountPercent > 0)
    {
        <div style="position:absolute; top:10px; right:10px; z-index:2;
                    background:var(--hs-red); color:white;
                    font-size:0.7rem; font-weight:700; letter-spacing:0.05em;
                    padding:3px 8px; border-radius:3px; text-transform:uppercase;">
            -@Product.DiscountPercent%
        </div>
    }

    @* Compare button *@
    <div style="position:absolute; top:8px; left:8px; z-index:2;" @onclick:stopPropagation="true">
        <MudTooltip Text="@(ComparisonService.Contains(Product.Id) ? "Bỏ khỏi so sánh" : "Thêm vào so sánh")">
            <MudIconButton Icon="@(ComparisonService.Contains(Product.Id) ? Icons.Material.Filled.CompareArrows : Icons.Material.Outlined.CompareArrows)"
                           Size="Size.Small"
                           Color="@(ComparisonService.Contains(Product.Id) ? Color.Primary : Color.Default)"
                           Style="background:rgba(255,255,255,0.9); padding:4px;"
                           OnClick="HandleCompareClick" />
        </MudTooltip>
    </div>

    @* Product image *@
    <div style="background:#F8F8F8; padding:16px; display:flex; justify-content:center; align-items:center; height:180px; border-bottom:1px solid var(--hs-border);">
        @if (!string.IsNullOrEmpty(Product.ThumbnailUrl))
        {
            <img src="@Product.ThumbnailUrl" alt="@Product.Name"
                 style="max-height:100%; max-width:100%; object-fit:contain;" />
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" Color="Color.Surface" />
        }
    </div>

    @* Card content *@
    <div style="padding:12px 14px 14px; flex:1; display:flex; flex-direction:column; gap:6px;">
        <div style="font-size:0.82rem; font-weight:600; color:var(--hs-text); line-height:1.35;
                    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; min-height:36px;">
            @Product.Name
        </div>

        <div style="margin-top:auto;">
            @if (Product.DiscountPercent > 0)
            {
                <div style="font-size:0.75rem; color:var(--hs-text-muted); text-decoration:line-through; line-height:1.2;">
                    @Product.OldPrice.ToString("N0") đ
                </div>
            }
            <div style="font-size:1.05rem; font-weight:700; color:var(--hs-red); line-height:1.2; margin-top:2px;">
                @Product.CurrentPrice.ToString("N0") đ
            </div>

            <div style="display:flex; align-items:center; gap:4px; margin-top:6px;">
                <MudRating SelectedValue="(int)Product.Rating" Max="5" Size="Size.Small" ReadOnly="true"
                           Style="pointer-events:none;" UserAttributes='@(new Dictionary<string, object> { ["tabindex"] = "-1" })' />
                <span style="font-size:0.7rem; color:var(--hs-text-muted);">(@Product.ReviewCount)</span>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public ProductCardResponse Product { get; set; } = default!;

    private void HandleClick()
    {
        NavigationManager.NavigateTo($"/product/{Product.Slug}");
    }

    private void HandleCompareClick()
    {
        if (ComparisonService.Contains(Product.Id))
        {
            ComparisonService.Remove(Product.Id);
            return;
        }
        var result = ComparisonService.TryAdd(Product);
        if (!result.Success && result.ErrorMessage != null)
            Snackbar.Add(result.ErrorMessage, Severity.Warning);
        else if (result.Replaced)
            Snackbar.Add($"Chỉ có thể so sánh sản phẩm cùng nhóm hàng. {result.OldCategoryName} đã được xoá khỏi giỏ so sánh.", Severity.Warning);
        else if (result.Success)
            Snackbar.Add($"Đã thêm \"{Product.Name}\" vào danh sách so sánh.", Severity.Success);
        StateHasChanged();
    }
}
